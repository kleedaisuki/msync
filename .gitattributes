*.sh text eol=lf
*.cs text eol=lf
# Embedded language sources contain literal newlines; checkout must not change values.
*.msync text eol=lf
src/Msync.Cli/Skills/*.md text eol=lf
packaging/licenses/** -text
# Preserve the upstream license bytes, including its final blank line.
legacy/vendor/rustyline/LICENSE -text whitespace=-blank-at-eof
vendor/unicode/** -text whitespace=-blank-at-eof

# Keep upstream formatting; lint only the msync-owned integration and patches.
vendor/PrettyPrompt/** whitespace=-blank-at-eol,-blank-at-eof
# Preserve the exact upstream MPL license including its final blank line.
vendor/PrettyPrompt/LICENSE -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
