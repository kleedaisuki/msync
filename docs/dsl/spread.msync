# Physical endpoints use @; lexical Scope members use ::.
let remote = $wsl;
let config = ~/.codex/config.toml;
config @ remote -> config;

# A directory destination retains the source's filename.
~/.codex/AGENTS.md @ $local -> ~/.codex/;

# SSH aliases use the native client configuration when an operation runs.
let server = ssh://forge;
config -> ~/.codex/config.toml @ server;

# Dot-prefixed names are ordinary bindings. Regex paths select file sets.
let .codex = ~/.codex;
.codex/agents/<.+\.toml> -> ~/.codex/agents/ @ remote;

# Paths are values; explicit conversion produces their textual spelling.
let settings = scope { config: config, remote: remote };
let description = settings::config as String;
