{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:macro|symbol|boolean|if|else(?:\\s+if)?|for|loop)\\b.*|[^\\s:=]+\\s*(?::=|=)\\s*loop)\\s*:\\s*(?:#.*)?$"
  },
  "folding": {
    "offSide": true
  }
}
