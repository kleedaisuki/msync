{
  "name": "msync-language",
  "displayName": "msync Language",
  "description": "Inferred types, actionable diagnostics, navigation and formatting for msync 0.8",
  "version": "0.8.1",
  "publisher": "msync",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onLanguage:msync",
    "onLanguage:msync-ir",
    "onCustomEditor:msync.bytecode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "msync",
        "aliases": [
          "msync"
        ],
        "extensions": [
          ".msync"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "msync-ir",
        "aliases": [
          "msync Typed IR"
        ],
        "extensions": [
          ".msync-ir"
        ]
      }
    ],
    "grammars": [
      {
        "language": "msync",
        "scopeName": "source.msync",
        "path": "./syntaxes/msync.tmLanguage.json",
        "unbalancedBracketScopes": [
          "string.regexp.msync"
        ]
      },
      {
        "language": "msync-ir",
        "scopeName": "source.msync-ir",
        "path": "./syntaxes/msync-ir.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "msync",
        "path": "./snippets/msync.code-snippets"
      }
    ],
    "configuration": {
      "title": "msync",
      "properties": {
        "msync.serverPath": {
          "type": "string",
          "default": "msync",
          "scope": "machine",
          "description": "Path to the msync 0.8 executable. Launched directly with --language-server; shell arguments are not accepted. Changes restart the server automatically."
        }
      }
    },
    "commands": [
      {
        "command": "msync.restartLanguageServer",
        "title": "msync: Restart Language Server"
      },
      {
        "command": "msync.openArtifactText",
        "title": "msync: Open Artifact as Read-only IR"
      },
      {
        "command": "msync.refreshArtifact",
        "title": "msync: Refresh Artifact View"
      }
    ],
    "customEditors": [
      {
        "viewType": "msync.bytecode",
        "displayName": "msync Typed Artifact",
        "selector": [
          {
            "filenamePattern": "*.mhir"
          },
          {
            "filenamePattern": "*.MHIR"
          },
          {
            "filenamePattern": "*.mso"
          },
          {
            "filenamePattern": "*.mexe"
          },
          {
            "filenamePattern": "*.MSO"
          },
          {
            "filenamePattern": "*.MEXE"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "msync.openArtifactText",
          "when": "resourceExtname == .mhir || resourceExtname == .MHIR || resourceExtname == .mso || resourceExtname == .mexe || resourceExtname == .MSO || resourceExtname == .MEXE",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "msync.openArtifactText",
          "when": "activeCustomEditorId == msync.bytecode",
          "group": "navigation"
        },
        {
          "command": "msync.refreshArtifact",
          "when": "activeCustomEditorId == msync.bytecode || resourceScheme == msync-artifact",
          "group": "navigation"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "protocol",
        "superType": "type",
        "description": "The protocol scheme of an unquoted endpoint URI, such as ssh or tcp."
      },
      {
        "id": "endpoint",
        "superType": "string",
        "description": "The address portion of an unquoted endpoint URI, including its user, host, port and path."
      },
      {
        "id": "controlKeyword",
        "superType": "keyword",
        "description": "Conditional and matching control flow, including the null-test question mark."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "msync",
        "scopes": {
          "protocol": [
            "support.type.protocol.msync"
          ],
          "endpoint": [
            "string.unquoted.endpoint.msync"
          ],
          "function": [
            "entity.name.function.msync"
          ],
          "type": [
            "entity.name.type.msync"
          ],
          "variable": [
            "variable.other.readwrite.msync"
          ],
          "controlKeyword": [
            "keyword.control.msync"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[msync]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.defaultFormatter": "msync.msync-language"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build": "node build.cjs",
    "vscode:prepublish": "npm run build",
    "test:integration": "node test/integration/run.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vscode-uri": "3.2.0"
  }
}
