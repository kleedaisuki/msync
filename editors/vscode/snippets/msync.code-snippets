{
  "Function": { "prefix": "fn", "body": ["fn ${1:copy}(${2:source, destination}) {", "    ${3:source -> destination}", "};"], "description": "Declare an inferred generic function" },
  "Anonymous function": { "prefix": "fnvalue", "body": ["let ${1:operation} = fn (${2:item}) {", "    ${3:item}", "};"], "description": "Bind a first-class function" },
  "Binding": { "prefix": "let", "body": ["let ${1:value} = ${2:expression};"], "description": "Bind an inferred non-null value" },
  "Nullable binding": { "prefix": "letnull", "body": ["let ${1:file}? = if exists ${2:path} { ${2:path} } else { null };"], "description": "Bind a value which may be null" },
  "Conditional": { "prefix": "if", "body": ["if ${1:true} {", "    $2", "} else {", "    $3", "};"], "description": "Branch with value-returning blocks" },
  "Match": { "prefix": "match", "body": ["match ${1:value} {", "    ${2:null} => { $3 },", "    _ => { $4 },", "}"], "description": "Exhaustively match a value" },
  "Range loop": { "prefix": "for", "body": ["for ${1:item} in ${2:root}/<${3:.+}> {", "    $0", "};"], "description": "Iterate a lazy range" },
  "Value loop": { "prefix": "loop", "body": ["let ${1:result} = loop {", "    break ${2:\"done\"};", "};"], "description": "Evaluate a loop result" },
  "Ordered range": { "prefix": "range", "body": ["[${1:\"first\"}, ${2:true}, ${3:./file} @ \\$local]"], "description": "Construct an ordered typed range" },
  "Range pipeline": { "prefix": "rangefilter", "body": ["${1:items} | \\$std::ranges::filter(${2:predicate})"], "description": "Filter a lazy range through the standard library" },
  "Namespace": { "prefix": "scope", "body": ["scope ${1:module} {", "    ${2:item}: ${3:value},", "};"], "description": "Declare a lexical namespace" },
  "Directory predicate": { "prefix": "isdir", "body": ["\\$std::fs::is_directory(${1:path})"], "description": "Inspect a directory at its selected endpoint" },
  "Native function": { "prefix": "native", "body": ["native fn ${1:name}(${2:argument}: ${3:Path}) -> ${4:Bool};"], "description": "Declare a typed host-implemented function" },
  "Connection": { "prefix": "remote", "body": ["let ${1:remote} = ssh://${2:forge};"], "description": "Bind a native SSH connection" },
  "Qualified path": { "prefix": "at", "body": ["${1:./file} @ ${2:\\$local}"], "description": "Select the physical endpoint for a Path or String" },
  "Concept": { "prefix": "concept", "body": ["concept ${1:Monoid} {", "    type Self;", "    identity: Self,", "    combine: fn(left: Self, right: Self) -> Self,", "};"], "description": "Declare a named structural algebra contract" },
  "Explicit conversion": { "prefix": "as", "body": ["${1:value} as ${2:String}"], "description": "Explicitly convert a value to a supported type" }
}
