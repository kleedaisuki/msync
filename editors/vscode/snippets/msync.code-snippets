{
  "Boolean predicate": { "prefix": "boolean", "body": ["boolean ${1:predicate}(${2:item}):", "    return ${3:exists item}"], "description": "Declare a typed boolean predicate" },
  "Symbol function": { "prefix": "symbol", "body": ["symbol ${1:identity}(${2:item}):", "    return ${3:item}"], "description": "Declare a pure symbol function" },
  "Macro": { "prefix": "macro", "body": ["macro ${1:copy}(${2:source, destination}):", "    ${3:source -> destination}"], "description": "Declare a lexical macro" },
  "Conditional": { "prefix": "if", "body": ["if ${1:true}:", "    $2", "else:", "    $3"], "description": "Branch on a bool value" },
  "Range loop": { "prefix": "for", "body": ["for ${1:item} in ${2:root}/<${3:.+}>:", "    $0"], "description": "Iterate a lazy range" },
  "Value loop": { "prefix": "loop", "body": ["${1:result} = loop:", "    break ${2:\"done\"}"], "description": "Evaluate a loop result" },
  "Ordered range": { "prefix": "range", "body": ["[${1:\"first\"}, ${2:true}, \\$local::${3:path}]"], "description": "Construct an ordered typed range" },
  "View pipeline": { "prefix": "viewfilter", "body": ["${1:items} | \\$view::filter(${2:predicate})"], "description": "Apply a builtin lazy view" },
  "Conditional release": { "prefix": "ifrelease", "body": ["if release ${1:true}:", "    $0"], "description": "Schedule a bool condition with release" },
  "Conditional acquire": { "prefix": "ifacquire", "body": ["if acquire ${1:true}:", "    $0"], "description": "Schedule a bool condition with acquire" },
  "Conditional acqrel": { "prefix": "ifacqrel", "body": ["if acqrel ${1:true}:", "    $0"], "description": "Schedule a bool condition with acqrel" }
}
