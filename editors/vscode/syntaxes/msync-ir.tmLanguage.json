{
  "name": "msync Typed IR",
  "scopeName": "source.msync-ir",
  "patterns": [
    { "name": "comment.line.semicolon.msync-ir", "match": ";.*$" },
    { "name": "string.quoted.double.msync-ir", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.msync-ir", "match": "\\\\." }] },
    {
      "match": "^(\\s*)([0-9]+)(:\\s+)(GetMember|SetMember)(\\s+)(\"(?:\\\\.|[^\"\\\\])*\")",
      "captures": {
        "2": { "name": "constant.numeric.address.msync-ir" },
        "4": { "name": "keyword.operator.msync-ir" },
        "6": { "name": "variable.other.property.msync-ir" }
      }
    },
    {
      "begin": "^(\\s*)([0-9]+)(:\\s+)(MakeScope)\\b",
      "beginCaptures": {
        "2": { "name": "constant.numeric.address.msync-ir" },
        "4": { "name": "keyword.operator.msync-ir" }
      },
      "end": "$",
      "patterns": [
        { "name": "variable.other.property.msync-ir", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.msync-ir", "match": "\\\\." }] },
        { "include": "#layout" },
        { "include": "#numbers" }
      ]
    },
    {
      "match": "^(\\s*)([0-9]+)(:\\s+)(Jump(?:IfTrue|IfFalse)?|Return|IteratorNext|Barrier|Acquire)(?=\\s|$)",
      "captures": {
        "2": { "name": "constant.numeric.address.msync-ir" },
        "4": { "name": "keyword.control.msync-ir" }
      }
    },
    {
      "match": "^(\\s*)([0-9]+)(:\\s+)([A-Za-z][A-Za-z0-9_]*)",
      "captures": {
        "2": { "name": "constant.numeric.address.msync-ir" },
        "4": { "name": "keyword.operator.msync-ir" }
      }
    },
    { "name": "keyword.declaration.msync-ir", "match": "\\b(?:artifact|context|const|fn|block|entry|origin|format|language|optimization|semantics|captures|locals|successors|effects|pure|readonly)\\b" },
    { "name": "keyword.control.msync-ir", "match": "\\b(?:release|acquire|acqrel|before-and-after|before|after|region-start|join)\\b" },
    { "name": "entity.name.function.msync-ir", "match": "@f[0-9]+" },
    { "name": "constant.other.reference.msync-ir", "match": "[@%]c[0-9]+" },
    { "name": "entity.name.label.msync-ir", "match": "@b[0-9]+_[0-9]+|\\bb[0-9]+\\b" },
    { "name": "entity.name.type.msync-ir", "match": "\\b(?:Null|Bool|Number|String|Path|Scope|Function|Connection|Process|Range|Type|Never|Any)\\b" },
    { "name": "support.type.path.msync-ir", "match": "\\bpath(?=\\s*\\()" },
    { "name": "support.function.constructor.msync-ir", "match": "\\b(?:number|connection|closure|native|type|scope)(?=\\s*[({])" },
    { "name": "variable.other.msync-ir", "match": "%[0-9]+|\\b(?:local|capture|arg)[0-9]+\\b" },
    { "name": "constant.language.msync-ir", "match": "\\b(?:null|true|false)\\b" },
    { "include": "#layout" },
    { "include": "#numbers" }
  ],
  "repository": {
    "layout": { "name": "variable.other.property.layout.msync-ir", "match": "\\b(?:fields|slot|allocation-site|layout-checked|hint|raw|cwd|home|endpoint|bits|source)\\b" },
    "numbers": { "name": "constant.numeric.msync-ir", "match": "(?<![A-Za-z0-9_])[+-]?(?:0x[0-9a-fA-F]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|Infinity|NaN)\\b" }
  }
}
