{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "msync",
  "scopeName": "source.msync",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#endpoints"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#ranges"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#paths"
    }
  ],
  "repository": {
    "comments": {
      "match": "(?<!\\S)#.*$",
      "name": "comment.line.number-sign.msync"
    },
    "strings": {
      "begin": "\"",
      "end": "\"|(?=$)",
      "name": "string.quoted.double.msync",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.msync"
        }
      },
      "patterns": [
        {
          "match": "\\\\[\\\\\"nrt]",
          "name": "constant.character.escape.msync"
        }
      ]
    },
    "declarations": {
      "begin": "^(\\s*)(macro|symbol|boolean)(\\s+)([\\p{L}\\p{N}_.-]+)(\\s*\\()",
      "end": "\\)|(?=$)",
      "name": "meta.function.msync",
      "beginCaptures": {
        "2": {
          "name": "storage.type.function.msync"
        },
        "4": {
          "name": "entity.name.function.msync"
        },
        "5": {
          "name": "punctuation.definition.parameters.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.msync"
        }
      },
      "patterns": [
        {
          "match": "[\\p{L}\\p{N}_.-]+",
          "name": "variable.parameter.msync"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameters.msync"
        }
      ]
    },
    "endpoints": {
      "match": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s(),\"]+",
      "name": "string.unquoted.endpoint.msync"
    },
    "selectors": {
      "begin": "(?<![\\p{L}\\p{N}_.)\"\\]>])<(?![=\\s\"])",
      "end": ">(?=$|[\\s/\\\\,)\\|]|->|=>|:=)|(?=$)",
      "name": "string.regexp.msync",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.end.msync"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.regexp.msync"
        },
        {
          "begin": "\\[",
          "end": "\\]|(?=$)",
          "name": "constant.other.character-class.regexp.msync",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.regexp.msync"
            }
          ]
        },
        {
          "match": "[+*?.|^$]",
          "name": "keyword.operator.regexp.msync"
        }
      ]
    },
    "ranges": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(views|ranges)(::)([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.msync"
        },
        "2": {
          "name": "punctuation.accessor.msync"
        },
        "3": {
          "name": "support.function.range.msync"
        }
      }
    },
    "namespaces": {
      "match": "(\\$?[\\p{L}\\p{N}_.-]+)(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.msync"
        },
        "2": {
          "name": "punctuation.accessor.msync"
        }
      }
    },
    "bindings": {
      "match": "[\\p{L}\\p{N}_.-]+(?=\\s*(?::=|=>|=(?!=)))",
      "name": "variable.other.readwrite.msync"
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:true|false)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "constant.language.boolean.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:and|or|not|exists)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.operator.logical.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:macro|symbol|boolean|return|global|drop|delete|include|execute|if|else|for|in|loop|break|release|acquire|acqrel|async|await)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.control.msync"
        }
      ]
    },
    "calls": {
      "match": "[\\p{L}\\p{N}_.-]+(?=\\s*\\()",
      "name": "entity.name.function.msync"
    },
    "numbers": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:-])[0-9]+(?![\\p{L}\\p{N}_./\\\\:-])",
      "name": "constant.numeric.count.msync"
    },
    "operators": {
      "match": "->|=>|:=|==|!=|<=|>=|[=<>|/]",
      "name": "keyword.operator.msync"
    },
    "punctuation": {
      "match": "[(),:]",
      "name": "punctuation.separator.msync"
    },
    "paths": {
      "match": "[^\\s\"(),<>|=]+",
      "name": "variable.other.readwrite.msync"
    }
  }
}
