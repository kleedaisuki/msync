{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "msync",
  "scopeName": "source.msync",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#concept-declarations"
    },
    {
      "include": "#scope-declarations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#endpoints"
    },
    {
      "include": "#selectors"
    },
    {
      "include": "#standard-namespaces"
    },
    {
      "include": "#ranges"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#lookups"
    },
    {
      "include": "#typed-bindings"
    },
    {
      "include": "#bindings"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#casts"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#paths"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "(?<!\\S)#.*$",
          "name": "comment.line.number-sign.msync"
        },
        {
          "match": "(?<!\\S)//.*$",
          "name": "comment.line.double-slash.msync"
        }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.msync",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.msync"
        }
      },
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.quote.msync"
        }
      ],
      "applyEndPatternLast": true
    },
    "declarations": {
      "patterns": [
        {
          "begin": "(?<![\\p{L}\\p{N}_./\\\\:-])(fn)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(\\s*\\()",
          "end": "\\)(?!\\s*->)|(?=[{};]|$)",
          "name": "meta.function.msync",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.msync"
            },
            "3": {
              "name": "entity.name.function.msync"
            },
            "4": {
              "name": "punctuation.definition.parameters.begin.msync"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.msync"
            }
          },
          "patterns": [
            {
              "begin": "->",
              "end": "(?=[{};,]|$)",
              "beginCaptures": {
                "0": {
                  "name": "keyword.operator.msync"
                }
              },
              "patterns": [
                {
                  "include": "#associated-bindings"
                },
                {
                  "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
                  "name": "entity.name.type.msync"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "match": "\\)",
              "name": "punctuation.definition.parameters.end.msync"
            },
            {
              "begin": ":(?!:)",
              "end": "(?=[,)])",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.separator.msync"
                }
              },
              "patterns": [
                {
                  "include": "#associated-bindings"
                },
                {
                  "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
                  "name": "entity.name.type.msync"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "include": "#types"
            },
            {
              "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
              "name": "variable.parameter.msync"
            },
            {
              "match": "\\?",
              "name": "keyword.control.msync"
            },
            {
              "match": "[:|]",
              "name": "keyword.operator.msync"
            },
            {
              "match": ",",
              "name": "punctuation.separator.parameters.msync"
            }
          ]
        },
        {
          "begin": "(?<![\\p{L}\\p{N}_./\\\\:-])(fn)(\\s*\\()",
          "end": "\\)(?!\\s*->)|(?=[{};]|$)",
          "name": "meta.function.msync",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.msync"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.msync"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.parameters.end.msync"
            }
          },
          "patterns": [
            {
              "begin": "->",
              "end": "(?=[{};,]|$)",
              "beginCaptures": {
                "0": {
                  "name": "keyword.operator.msync"
                }
              },
              "patterns": [
                {
                  "include": "#associated-bindings"
                },
                {
                  "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
                  "name": "entity.name.type.msync"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "match": "\\)",
              "name": "punctuation.definition.parameters.end.msync"
            },
            {
              "begin": ":(?!:)",
              "end": "(?=[,)])",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.separator.msync"
                }
              },
              "patterns": [
                {
                  "include": "#associated-bindings"
                },
                {
                  "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
                  "name": "entity.name.type.msync"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "include": "#types"
            },
            {
              "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
              "name": "variable.parameter.msync"
            },
            {
              "match": "\\?",
              "name": "keyword.control.msync"
            },
            {
              "match": "[:|]",
              "name": "keyword.operator.msync"
            },
            {
              "match": ",",
              "name": "punctuation.separator.parameters.msync"
            }
          ]
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(fn)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.msync"
            },
            "3": {
              "name": "entity.name.function.msync"
            }
          }
        }
      ]
    },
    "endpoints": {
      "match": "([A-Za-z][A-Za-z0-9+.-]*)(://)((?:\\[[^\\]\\s\"(){};]*\\]?|[^\\s(),\"\\[\\]{};])*)",
      "captures": {
        "1": {
          "name": "support.type.protocol.msync"
        },
        "2": {
          "name": "keyword.operator.protocol.msync"
        },
        "3": {
          "name": "string.unquoted.endpoint.msync"
        }
      }
    },
    "selectors": {
      "begin": "(?<![\\p{L}\\p{N}_.)\"\\]>])<(?![=\\s\"])",
      "end": ">(?=$|[\\s/\\\\,)\\|};]|\\]|:|->|=>)|(?=$)",
      "name": "string.regexp.msync",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.regexp.end.msync"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.regexp.msync"
        },
        {
          "begin": "\\[",
          "end": "\\]|(?=$)",
          "name": "constant.other.character-class.regexp.msync",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.regexp.msync"
            }
          ]
        },
        {
          "match": "[+*?.|^$]",
          "name": "keyword.operator.regexp.msync"
        }
      ]
    },
    "ranges": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\$-])(\\$)(std)(::)(ranges)(::)([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "keyword.operator.msync"
        },
        "2": {
          "name": "entity.name.type.msync"
        },
        "3": {
          "name": "keyword.operator.msync"
        },
        "4": {
          "name": "entity.name.type.msync"
        },
        "5": {
          "name": "keyword.operator.msync"
        },
        "6": {
          "name": "entity.name.function.msync"
        }
      }
    },
    "namespaces": {
      "patterns": [
        {
          "match": "(\\$)(std)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.msync"
            },
            "2": {
              "name": "entity.name.type.msync"
            }
          }
        },
        {
          "match": "(\\$)?([\\p{L}\\p{N}_.-]+)(::)",
          "captures": {
            "1": {
              "name": "keyword.operator.msync"
            },
            "2": {
              "name": "variable.other.readwrite.msync"
            },
            "3": {
              "name": "keyword.operator.msync"
            }
          }
        },
        {
          "match": "::",
          "name": "keyword.operator.msync"
        }
      ]
    },
    "bindings": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(let)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(\\?)?",
      "captures": {
        "1": {
          "name": "storage.type.variable.msync"
        },
        "3": {
          "name": "variable.other.readwrite.msync"
        },
        "4": {
          "name": "keyword.control.msync"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:true|false)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "constant.language.boolean.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])null(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "constant.language.null.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:and|or|not|exists|is)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.operator.logical.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:native|let|global|drop|include|execute|decltype)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.other.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])fn(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.declaration.function.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])scope(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.declaration.scope.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:if|else|match|for|in|loop|break|return|release|acquire|acqrel)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.control.msync"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:concept|type|typename)(?![\\p{L}\\p{N}_./\\\\-])",
          "name": "keyword.declaration.concept.msync"
        }
      ]
    },
    "calls": {
      "match": "[\\p{L}\\p{N}_.-]+(?=\\s*\\()",
      "name": "entity.name.function.msync"
    },
    "numbers": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:])(?:0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*|0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|(?:[0-9](?:_?[0-9])*(?:\\.(?:[0-9](?:_?[0-9])*)?)?|\\.[0-9](?:_?[0-9])*)(?:[eE][+-]?[0-9](?:_?[0-9])*)?)(?![\\p{L}\\p{N}_.\\\\:])(?!-[\\p{L}_])",
      "name": "constant.numeric.msync"
    },
    "operators": {
      "patterns": [
        {
          "match": "\\?",
          "name": "keyword.control.msync"
        },
        {
          "match": "::|\\*\\*|->|=>|==|!=|<=|>=|[=<>|/$@+*%]|-(?=\\s|[0-9.]|$)",
          "name": "keyword.operator.msync"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\[",
          "name": "punctuation.section.brackets.begin.msync"
        },
        {
          "match": "\\]",
          "name": "punctuation.section.brackets.end.msync"
        },
        {
          "match": "[(),:;]",
          "name": "punctuation.separator.msync"
        },
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.msync"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.msync"
        }
      ]
    },
    "paths": {
      "match": "[^\\s\"(),\\[\\]{};?<>|=/:$@]+",
      "name": "variable.other.readwrite.msync"
    },
    "scope-declarations": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(scope)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "keyword.declaration.scope.msync"
        },
        "3": {
          "name": "entity.name.type.msync"
        }
      }
    },
    "lookups": {
      "match": "(\\$)([\\p{L}\\p{N}_.-]+)",
      "captures": {
        "1": {
          "name": "keyword.operator.msync"
        },
        "2": {
          "name": "variable.other.readwrite.msync"
        }
      }
    },
    "types": {
      "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(?:Range|String|Function|Scope|Path|Process|Connection|Null|Bool|Type|Number)(?![\\p{L}\\p{N}_./\\\\-])",
      "name": "entity.name.type.msync"
    },
    "typed-bindings": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])(let)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(\\?)?(?=\\s*=\\s*fn\\b)",
          "captures": {
            "1": {
              "name": "storage.type.variable.msync"
            },
            "3": {
              "name": "entity.name.function.msync"
            },
            "4": {
              "name": "keyword.control.msync"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_./\\\\:-])([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*:(?!:)\\s*fn\\b)",
          "name": "entity.name.function.msync"
        }
      ]
    },
    "associated-bindings": {
      "match": "\\b(typename)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.type.msync"
        },
        "3": {
          "name": "entity.name.type.msync"
        }
      }
    },
    "concept-declarations": {
      "begin": "(?<![\\p{L}\\p{N}_./\\\\:-])(concept)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)(\\s*\\{)",
      "end": "\\}",
      "name": "meta.concept.msync",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.concept.msync"
        },
        "3": {
          "name": "entity.name.type.msync"
        },
        "4": {
          "name": "punctuation.section.block.begin.msync"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.msync"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(type|typename)(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.msync"
            },
            "3": {
              "name": "entity.name.type.msync"
            }
          }
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*:(?!:)\\s*fn\\b)",
          "name": "entity.name.function.msync"
        },
        {
          "include": "#declarations"
        },
        {
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)(\\??)(\\s*:(?!:))",
          "captures": {
            "1": {
              "name": "variable.other.property.msync"
            },
            "2": {
              "name": "keyword.control.msync"
            },
            "3": {
              "name": "punctuation.separator.msync"
            }
          }
        },
        {
          "include": "#keywords"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "entity.name.type.msync"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "casts": {
      "begin": "(?<![\\p{L}\\p{N}_./\\\\:-])(as)(?![\\p{L}\\p{N}_./\\\\-])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.msync"
        }
      },
      "end": "(?=[^\\s\\p{L}\\p{N}_?|])|(?=$)|(?=\\s+(?:and|or|is|as)\\b)",
      "patterns": [
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "entity.name.type.msync"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "standard-namespaces": {
      "begin": "(\\$)(std)(::)",
      "end": "(?=[^\\p{L}\\p{N}_.:-])|(?=$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.msync"
        },
        "2": {
          "name": "entity.name.type.msync"
        },
        "3": {
          "name": "keyword.operator.msync"
        }
      },
      "patterns": [
        {
          "match": "[\\p{L}\\p{N}_.-]+(?=::)",
          "name": "entity.name.type.msync"
        },
        {
          "match": "[\\p{L}\\p{N}_.-]+(?=\\s*\\()",
          "name": "entity.name.function.msync"
        },
        {
          "match": "::",
          "name": "keyword.operator.msync"
        },
        {
          "match": "[\\p{L}\\p{N}_.-]+",
          "name": "variable.other.readwrite.msync"
        }
      ]
    }
  }
}
