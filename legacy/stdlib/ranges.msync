# $std::ranges lowers the following source compositions into typed lazy range IR.
# $view remains the compatible primitive scope used to express these definitions.
scope ranges:
    symbol single(value):
        return [value]
    symbol identity(values):
        return values
    symbol all(values):
        return values
    symbol as_const(values):
        return values
    symbol as_rvalue(values):
        return values
    symbol common(values):
        return values
    symbol step(values, count):
        return values | $view::stride(count)
    symbol first(values):
        return values | $view::front
    symbol last(values):
        return values | $view::back
    symbol reverse(values):
        return values | $view::reverse
    symbol unique(values):
        return values | $view::unique
    symbol take(values, count):
        return values | $view::take(count)
    symbol drop(values, count):
        return values | $view::drop(count)
    symbol stride(values, count):
        return values | $view::stride(count)
    boolean empty(values):
        return values | $view::empty
    boolean contains(values, value):
        return values | $view::contains(value)
    symbol front(values):
        return values | $view::front
    symbol back(values):
        return values | $view::back
    symbol find(values, value):
        return values | $view::find(value)
    # Variadic values and callback parameters are specialized compiler-native inputs.
    native of(values...) = "ranges.of"
    native filter(values, predicate) = "ranges.filter"
    native transform(values, function) = "ranges.transform"
    native take_while(values, predicate) = "ranges.take_while"
    native drop_while(values, predicate) = "ranges.drop_while"
    native any(values, predicate) = "ranges.any"
    native any_of(values, predicate) = "ranges.any_of"
    native all_of(values, predicate) = "ranges.all_of"
    native none(values, predicate) = "ranges.none"
    native none_of(values, predicate) = "ranges.none_of"
    native find_if(values, predicate) = "ranges.find_if"
