# Unicode-aware text operations use native Rust string primitives.
scope string:
    native contains(text, part) -> Bool = "string.contains"
    native starts_with(text, prefix) -> Bool = "string.starts_with"
    native ends_with(text, suffix) -> Bool = "string.ends_with"
    native concat(left, right) -> String = "string.concat"
    native trim(text) -> String = "string.trim"
    native trim_start(text) -> String = "string.trim_start"
    native trim_end(text) -> String = "string.trim_end"
    native to_lowercase(text) -> String = "string.to_lowercase"
    native to_uppercase(text) -> String = "string.to_uppercase"
    native replace(text, from, to) -> String = "string.replace"
    native split(text, separator) -> Range<String> = "string.split"
    boolean empty(text):
        return text == ""
    boolean equal(left, right):
        return left == right
