# Private row storage for source-defined ordered collections.
native fn new(element: Type) -> Storage;
native fn root(owner: Storage) -> Number;
native fn size(owner: Storage) -> Number;
native fn key(owner: Storage, index: Number) -> Bool | String | Path
    | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn child(owner: Storage, index: Number, left: Bool) -> Number;
native fn parent(owner: Storage, index: Number) -> Number;
native fn red(owner: Storage, index: Number) -> Bool;
native fn allocate(owner: Storage, key?, parent: Number) -> Number;
native fn release(owner: Storage, index: Number) -> Null;
native fn clear(owner: Storage) -> Null;
native fn set_root(owner: Storage, index: Number) -> Null;
native fn set_child(owner: Storage, index: Number, left: Bool, child: Number) -> Null;
native fn set_parent(owner: Storage, index: Number, parent: Number) -> Null;
native fn set_red(owner: Storage, index: Number, red: Bool) -> Null;
