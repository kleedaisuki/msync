# Canonical families keep instance data separate from shared operations.
# A storage policy may choose buffering, but retained state is always a snapshot.
scope SnapshotStorage {
    snapshot: fn(values: Range) -> Range {
        $std::ranges::materialize(values)
    },
};

fn construction_range(initial: Range | Type) {
    if decltype(initial) is Type {
        $std::ranges::empty_of(initial)
    } else {
        initial
    }
};

fn entry_seed(keys: Range, values: Range) {
    $std::ranges::transform($std::ranges::zip(keys, values), fn(pair) {
        scope { key?: pair::first, value?: pair::second }
    })
};

scope List {
    new: fn(initial: Range | Type) {
        List::with_storage(construction_range(initial), SnapshotStorage)
    },
    with_storage: fn(initial: Range | Type, storage: $std::concepts::RangeStorage) {
        scope {
            items: $std::ranges::materialize(storage::snapshot(construction_range(initial))),
            storage: storage,
        }
    },
    empty: fn(prototype?) {
        List::new($std::ranges::take([prototype], 0))
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        $std::ranges::materialize(self::items)
    },
    size: fn(self) {
        $std::ranges::size(self::items)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::items)
    },
    clear: fn(self) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::items, 0))
        );
    },
    get: fn(self, index: Number) {
        $std::ranges::at_or(self::items, index, null)
    },
    get_or: fn(self, index: Number, fallback?) {
        $std::ranges::at_or(self::items, index, fallback)
    },
    push: fn(self, value?) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::concat(self::items, [value]))
        );
    },
    extend: fn(self, values: Range) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::concat(self::items, values))
        );
    },
    insert: fn(self, index: Number, value?) {
        if index < 0 or index > List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::concat(
                        [value],
                        $std::ranges::drop(self::items, index)
                    )
                )
            )
        );
        true
    },
    set: fn(self, index: Number, value?) {
        if index < 0 or index >= List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::concat(
                        [value],
                        $std::ranges::drop(self::items, index + 1)
                    )
                )
            )
        );
        true
    },
    remove: fn(self, index: Number) {
        if index < 0 or index >= List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::drop(self::items, index + 1)
                )
            )
        );
        true
    },
    remove_where: fn(self, predicate: Function) {
        let previous = List::size(self);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(self::items, predicate)
            )
        );
        previous - List::size(self)
    },
    contains: fn(self, value?) {
        $std::ranges::contains(self::items, value)
    },
    index_of: fn(self, value?) {
        $std::ranges::index_of(self::items, value)
    },
    slice: fn(self, start: Number, count: Number) {
        $std::ranges::materialize(
            $std::ranges::slice(self::items, start, count)
        )
    },
    reverse: fn(self) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::reverse(self::items))
        );
    },
    sort_with: fn(self, less: Function) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::sort_with(self::items, less))
        );
    },
};

# Null is the absent alternative, outside a concrete comparison carrier.
scope Equivalence {
    same: fn(left?, right?) {
        if left is null {
            right is null
        } else {
            if right is null {
                false
            } else {
                left == right
            }
        }
    },
    test: fn(policy: $std::concepts::Equality, left?, right?) {
        if left is null {
            right is null
        } else {
            if right is null {
                false
            } else {
                policy::equal(left, right)
            }
        }
    },
};

scope EqualitySet {
    new: fn(initial: Range | Type) {
        let source = construction_range(initial);
        EqualitySet::with_policy(
            source,
            scope {
                Self: decltype($std::ranges::front(source)),
                equal: Equivalence::same,
            },
            SnapshotStorage
        )
    },
    with_equality: fn(initial: Range | Type, equality: $std::concepts::Equality) {
        EqualitySet::with_policy(initial, equality, SnapshotStorage)
    },
    with_policy: fn(
        initial: Range | Type,
        equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage
    ) {
        let source = $std::ranges::materialize(construction_range(initial));
        let self = scope {
            items: $std::ranges::materialize($std::ranges::take(source, 0)),
            equality: equality,
            storage: storage,
        };
        for value in source {
            EqualitySet::insert(self, value);
        };
        self
    },
    empty: fn(prototype?) {
        EqualitySet::new($std::ranges::take([prototype], 0))
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        $std::ranges::materialize(self::items)
    },
    size: fn(self) {
        $std::ranges::size(self::items)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::items)
    },
    clear: fn(self) {
        List::clear(self)
    },
    contains: fn(self, value?) {
        $std::ranges::any(
            self::items,
            fn(item?) {
                Equivalence::test(self::equality, item, value)
            }
        )
    },
    insert: fn(self, value?) {
        if EqualitySet::contains(self, value) {
            return false;
        };
        List::push(self, value);
        true
    },
    remove: fn(self, value?) {
        let previous = EqualitySet::size(self);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(
                    self::items,
                    fn(item?) {
                        Equivalence::test(self::equality, item, value)
                    }
                )
            )
        );
        previous != EqualitySet::size(self)
    },
    union_with: fn(self, other: Range) {
        for value in other {
            EqualitySet::insert(self, value);
        };
    },
    intersect_with: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::filter(
                    self::items,
                    fn(item?) {
                        $std::ranges::any(
                            values,
                            fn(value?) {
                                Equivalence::test(self::equality, item, value)
                            }
                        )
                    }
                )
            )
        );
    },
    except_with: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(
                    self::items,
                    fn(item?) {
                        $std::ranges::any(
                            values,
                            fn(value?) {
                                Equivalence::test(self::equality, item, value)
                            }
                        )
                    }
                )
            )
        );
    },
    is_subset_of: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        $std::ranges::all_of(
            self::items,
            fn(item?) {
                $std::ranges::any(
                    values,
                    fn(value?) {
                        Equivalence::test(self::equality, item, value)
                    }
                )
            }
        )
    },
    overlaps: fn(self, other: Range) {
        $std::ranges::any(
            other,
            fn(value?) {
                EqualitySet::contains(self, value)
            }
        )
    },
};

scope Map {
    new: fn(initial: Range) {
        Map::with_policy(
            initial,
            scope {
                Self: decltype($std::ranges::front(initial)::key),
                equal: Equivalence::same,
            },
            SnapshotStorage
        )
    },
    with_equality: fn(initial: Range, equality: $std::concepts::Equality) {
        Map::with_policy(initial, equality, SnapshotStorage)
    },
    with_policy: fn(
        initial: Range,
        equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage
    ) {
        let source = $std::ranges::materialize(initial);
        let empty = $std::ranges::take(source, 0);
        let self = Map::from_seeds(
            $std::ranges::transform(empty, fn(entry) { entry::key }),
            $std::ranges::transform(empty, fn(entry) { entry::value }),
            equality,
            storage
        );
        for entry in source {
            Map::insert(self, entry::key, entry::value);
        };
        self
    },
    from_seeds: fn(keys: Range, values: Range, equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage) {
        scope {
            keys: $std::ranges::materialize(keys),
            values: $std::ranges::materialize(values),
            equality: equality,
            storage: storage,
        }
    },
    of_types: fn(key: Type, value: Type) {
        Map::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope { Self: key, equal: Equivalence::same },
            SnapshotStorage
        )
    },
    of_types_with: fn(key: Type, value: Type, equality: $std::concepts::Equality) {
        Map::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            equality,
            SnapshotStorage
        )
    },
    empty: fn(key_prototype?, value_prototype?) {
        Map::new(
            $std::ranges::take(
                [
                    scope {
                        key?: key_prototype,
                        value?: value_prototype
                    }
                ],
                0
            )
        )
    },
    empty_nullable: fn(key_prototype?, value_prototype?) {
        Map::new(
            $std::ranges::take(
                [
                    scope {
                        key?: key_prototype,
                        value?: value_prototype
                    },
                    scope {
                        key?: key_prototype,
                        value?: null
                    }
                ],
                0
            )
        )
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(Map::entries(self)) },
    entries: fn(self) {
        $std::ranges::materialize(
            $std::ranges::transform(
                $std::ranges::zip(self::keys, self::values),
                fn(pair) {
                    scope {
                        key?: pair::first,
                        value?: pair::second
                    }
                }
            )
        )
    },
    keys: fn(self) {
        $std::ranges::materialize(self::keys)
    },
    values: fn(self) {
        $std::ranges::materialize(self::values)
    },
    size: fn(self) {
        $std::ranges::size(self::keys)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::keys)
    },
    clear: fn(self) {
        self::keys = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::keys, 0))
        );
        self::values = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::values, 0))
        );
    },
    locate: fn(self, key?) {
        $std::ranges::index_if(
            self::keys,
            fn(item?) {
                Equivalence::test(self::equality, item, key)
            }
        )
    },
    contains_key: fn(self, key?) {
        Map::locate(self, key) is not null
    },
    get: fn(self, key?) {
        Map::get_or(self, key, null)
    },
    get_or: fn(self, key?, fallback?) {
        let index? = Map::locate(self, key);
        if index is null {
            fallback
        } else {
            $std::ranges::at(self::values, index)
        }
    },
    insert: fn(self, key?, value?) {
        let index? = Map::locate(self, key);
        if index is null {
            self::keys = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(self::keys, [key])
                )
            );
            self::values = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(self::values, [value])
                )
            );
            true
        } else {
            self::values = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(
                        $std::ranges::take(self::values, index),
                        $std::ranges::concat(
                            [value],
                            $std::ranges::drop(self::values, index + 1)
                        )
                    )
                )
            );
            false
        }
    },
    try_insert: fn(self, key?, value?) {
        if Map::contains_key(self, key) {
            false
        } else {
            Map::insert(self, key, value)
        }
    },
    remove: fn(self, key?) {
        let index? = Map::locate(self, key);
        if index is null {
            return false;
        };
        self::keys = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::keys, index),
                    $std::ranges::drop(self::keys, index + 1)
                )
            )
        );
        self::values = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::values, index),
                    $std::ranges::drop(self::values, index + 1)
                )
            )
        );
        true
    },
};

scope Stack {
    new: fn(initial: Range | Type) {
        List::new(initial)
    },
    with_storage: fn(initial: Range, storage: $std::concepts::RangeStorage) {
        List::with_storage(initial, storage)
    },
    empty: fn(prototype?) {
        List::empty(prototype)
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        List::snapshot(self)
    },
    size: fn(self) {
        List::size(self)
    },
    is_empty: fn(self) {
        List::is_empty(self)
    },
    clear: fn(self) {
        List::clear(self)
    },
    push: fn(self, value?) {
        List::push(self, value)
    },
    peek: fn(self) {
        if List::is_empty(self) {
            null
        } else {
            List::get(self, List::size(self) - 1)
        }
    },
    pop: fn(self) {
        if List::is_empty(self) {
            return null;
        };
        let index = List::size(self) - 1;
        let value? = List::get(self, index);
        List::remove(self, index);
        value
    },
};

scope Queue {
    new: fn(initial: Range | Type) {
        List::new(initial)
    },
    with_storage: fn(initial: Range, storage: $std::concepts::RangeStorage) {
        List::with_storage(initial, storage)
    },
    empty: fn(prototype?) {
        List::empty(prototype)
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        List::snapshot(self)
    },
    size: fn(self) {
        List::size(self)
    },
    is_empty: fn(self) {
        List::is_empty(self)
    },
    clear: fn(self) {
        List::clear(self)
    },
    push: fn(self, value?) {
        List::push(self, value)
    },
    peek: fn(self) {
        List::get(self, 0)
    },
    pop: fn(self) {
        if List::is_empty(self) {
            return null;
        };
        let value? = List::get(self, 0);
        List::remove(self, 0);
        value
    },
};

# Container ordering treats Null first and all NaNs as one final equivalence
# class. Language Number comparison remains IEEE; Path ordering remains lexical.
scope NaturalOrder {
    less: fn(left?, right?) -> Bool {
        if left is null {
            return right is not null;
        };
        if right is null {
            return false;
        };
        if decltype(left) is Number {
            if left < right {
                return true;
            };
            if left >= right {
                return false;
            };
            return left == left and right != right;
        };
        left < right
    },
};

# Arena edges are Number indices; live nodes own bounded indexed key/value pages.
# A minimum degree of eight keeps page moves bounded and avoids recursive rows.
scope BTree {
    new: fn(key_prototype?, value_prototype?) {
        BTree::with_policy(
            key_prototype,
            value_prototype,
            scope {
                Self: decltype(key_prototype),
                sample?: key_prototype,
                less: NaturalOrder::less,
            }
        )
    },
    with_policy: fn(
        key_prototype?,
        value_prototype?,
        order: $std::concepts::StrictOrder
    ) {
        BTree::from_seeds(
            $std::ranges::empty_of(decltype(key_prototype)),
            $std::ranges::empty_of(decltype(value_prototype)),
            order, key_prototype, value_prototype
        )
    },
    of_types: fn(key: Type, value: Type) {
        BTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope { Self: key, sample?: null, less: NaturalOrder::less },
            null, null
        )
    },
    of_types_with: fn(key: Type, value: Type, order: $std::concepts::StrictOrder) {
        BTree::from_seeds(
            $std::ranges::empty_of(key), $std::ranges::empty_of(value), order, null, null
        )
    },
    from_seeds: fn(keys: Range, values: Range, order: $std::concepts::StrictOrder,
        key_prototype?, value_prototype?) {
        let key_seed = $std::ranges::take(keys, 0);
        let value_seed = $std::ranges::take(values, 0);
        let first = BTree::page(key_seed, value_seed, true);
        let nodes = $std::slots::new(decltype(first));
        let root = $std::slots::allocate(nodes, first);
        scope {
            nodes: nodes,
            root: root,
            count: 0,
            degree: 8,
            order: order,
            key_seed: key_seed,
            value_seed: value_seed,
            key_prototype?: key_prototype,
            value_prototype?: value_prototype,
        }
    },
    page: fn(key_seed: Range, value_seed: Range, leaf: Bool) {
        scope {
            leaf: leaf,
            keys: $std::storage::vector_empty(decltype($std::ranges::front(key_seed))),
            values: $std::storage::vector_empty(decltype($std::ranges::front(value_seed))),
            children: $std::storage::vector_empty(Number),
        }
    },
    node: fn(self, index: Number) {
        $std::slots::get(self::nodes, index)
    },
    allocate: fn(self, leaf: Bool) {
        $std::slots::allocate(
            self::nodes,
            BTree::page(self::key_seed, self::value_seed, leaf)
        )
    },
    retire: fn(self, index: Number) {
        $std::slots::release(self::nodes, index);
    },
    lower: fn(self, node, key?) {
        let low = 0;
        let high = $std::storage::vector_size(node::keys);
        loop {
            if low >= high {
                break;
            };
            let middle = $std::math::floor((low + high) / 2);
            if self::order::less(
                $std::storage::vector_get(node::keys, middle),
                key
            ) {
                low = middle + 1;
            } else {
                high = middle;
            };
        };
        low
    },
    equal: fn(self, left?, right?) {
        not self::order::less(left, right) and not self::order::less(
            right,
            left
        )
    },
    locate: fn(self, key?) {
        let current = self::root;
        loop {
            let node = BTree::node(self, current);
            let index = BTree::lower(self, node, key);
            if index < $std::storage::vector_size(node::keys) {
                if BTree::equal(
                    self,
                    $std::storage::vector_get(node::keys, index),
                    key
                ) {
                    return scope {
                        node: current,
                        index: index
                    };
                };
            };
            if node::leaf {
                return null;
            };
            current = $std::storage::vector_get(node::children, index);
        }
    },
    get: fn(self, key?) {
        let found? = BTree::locate(self, key);
        if found is null {
            null
        } else {
            $std::data::Option::some(
                $std::storage::vector_get(
                    BTree::node(self, found::node)::values,
                    found::index
                )
            )
        }
    },
    contains: fn(self, key?) {
        BTree::locate(self, key) is not null
    },
    size: fn(self) {
        self::count
    },
    is_empty: fn(self) {
        self::count == 0
    },
    split_child: fn(self, parent_index: Number, index: Number) {
        let parent = BTree::node(self, parent_index);
        let left_index = $std::storage::vector_get(parent::children, index);
        let left = BTree::node(self, left_index);
        let right_index = BTree::allocate(self, left::leaf);
        let right = BTree::node(self, right_index);
        let degree = self::degree;
        let pivot_key? = $std::storage::vector_get(left::keys, degree - 1);
        let pivot_value? = $std::storage::vector_get(left::values, degree - 1);
        for i in $std::ranges::sequence(degree, 2 * degree - 1, 1) {
            $std::storage::vector_push(
                right::keys,
                $std::storage::vector_get(left::keys, i)
            );
            $std::storage::vector_push(
                right::values,
                $std::storage::vector_get(left::values, i)
            );
        };
        if not left::leaf {
            for i in $std::ranges::sequence(degree, 2 * degree, 1) {
                $std::storage::vector_push(
                    right::children,
                    $std::storage::vector_get(left::children, i)
                );
            };
            for i in $std::ranges::sequence(0, degree, 1) {
                $std::storage::vector_pop(left::children);
            };
        };
        for i in $std::ranges::sequence(0, degree, 1) {
            $std::storage::vector_pop(left::keys);
            $std::storage::vector_pop(left::values);
        };
        $std::storage::vector_insert(parent::keys, index, pivot_key);
        $std::storage::vector_insert(parent::values, index, pivot_value);
        $std::storage::vector_insert(parent::children, index + 1, right_index);
    },
    insert_nonfull: fn(self, current: Number, key?, value?) {
        let node = BTree::node(self, current);
        let index = BTree::lower(self, node, key);
        if node::leaf {
            $std::storage::vector_insert(node::keys, index, key);
            $std::storage::vector_insert(node::values, index, value);
        } else {
            let child = $std::storage::vector_get(node::children, index);
            if $std::storage::vector_size(BTree::node(self, child)::keys) == 2
                * self::degree - 1 {
                BTree::split_child(self, current, index);
                if self::order::less(
                    $std::storage::vector_get(node::keys, index),
                    key
                ) {
                    index = index + 1;
                };
            };
            BTree::insert_nonfull(
                self,
                $std::storage::vector_get(node::children, index),
                key,
                value
            );
        };
    },
    insert: fn(self, key?, value?) {
        let found? = BTree::locate(self, key);
        if found is not null {
            $std::storage::vector_set(
                BTree::node(self, found::node)::values,
                found::index,
                value
            );
            return false;
        };
        if $std::storage::vector_size(BTree::node(self, self::root)::keys) == 2
            * self::degree - 1 {
            let previous = self::root;
            self::root = BTree::allocate(self, false);
            $std::storage::vector_push(
                BTree::node(self, self::root)::children,
                previous
            );
            BTree::split_child(self, self::root, 0);
        };
        BTree::insert_nonfull(self, self::root, key, value);
        self::count = self::count + 1;
        true
    },
    extreme: fn(self, current: Number, last: Bool) {
        let index = current;
        loop {
            let node = BTree::node(self, index);
            if node::leaf {
                let item = if last {
                    $std::storage::vector_size(node::keys) - 1
                } else {
                    0
                };
                return scope {
                    key?: $std::storage::vector_get(node::keys, item),
                    value?: $std::storage::vector_get(node::values, item),
                };
            };
            let child = if last {
                $std::storage::vector_size(node::children) - 1
            } else {
                0
            };
            index = $std::storage::vector_get(node::children, child);
        }
    },
    merge: fn(self, parent_index: Number, index: Number) {
        let parent = BTree::node(self, parent_index);
        let left_index = $std::storage::vector_get(parent::children, index);
        let right_index = $std::storage::vector_get(
            parent::children,
            index + 1
        );
        let left = BTree::node(self, left_index);
        let right = BTree::node(self, right_index);
        $std::storage::vector_push(
            left::keys,
            $std::storage::vector_remove(parent::keys, index)
        );
        $std::storage::vector_push(
            left::values,
            $std::storage::vector_remove(parent::values, index)
        );
        for i in $std::ranges::sequence(0, $std::storage::vector_size(right::keys), 1) {
            $std::storage::vector_push(left::keys, $std::storage::vector_get(right::keys, i));
            $std::storage::vector_push(left::values, $std::storage::vector_get(right::values, i));
        };
        for i in $std::ranges::sequence(0, $std::storage::vector_size(right::children), 1) {
            $std::storage::vector_push(left::children, $std::storage::vector_get(right::children, i));
        };
        $std::storage::vector_remove(parent::children, index + 1);
        BTree::retire(self, right_index);
        left_index
    },
    borrow_left: fn(self, parent_index: Number, index: Number) {
        let parent = BTree::node(self, parent_index);
        let child = BTree::node(
            self,
            $std::storage::vector_get(parent::children, index)
        );
        let sibling = BTree::node(
            self,
            $std::storage::vector_get(parent::children, index - 1)
        );
        $std::storage::vector_insert(
            child::keys,
            0,
            $std::storage::vector_get(parent::keys, index - 1)
        );
        $std::storage::vector_insert(
            child::values,
            0,
            $std::storage::vector_get(parent::values, index - 1)
        );
        $std::storage::vector_set(
            parent::keys,
            index - 1,
            $std::storage::vector_pop(sibling::keys)
        );
        $std::storage::vector_set(
            parent::values,
            index - 1,
            $std::storage::vector_pop(sibling::values)
        );
        if not child::leaf {
            $std::storage::vector_insert(
                child::children,
                0,
                $std::storage::vector_pop(sibling::children)
            );
        };
    },
    borrow_right: fn(self, parent_index: Number, index: Number) {
        let parent = BTree::node(self, parent_index);
        let child = BTree::node(
            self,
            $std::storage::vector_get(parent::children, index)
        );
        let sibling = BTree::node(
            self,
            $std::storage::vector_get(parent::children, index + 1)
        );
        $std::storage::vector_push(
            child::keys,
            $std::storage::vector_get(parent::keys, index)
        );
        $std::storage::vector_push(
            child::values,
            $std::storage::vector_get(parent::values, index)
        );
        $std::storage::vector_set(
            parent::keys,
            index,
            $std::storage::vector_remove(sibling::keys, 0)
        );
        $std::storage::vector_set(
            parent::values,
            index,
            $std::storage::vector_remove(sibling::values, 0)
        );
        if not child::leaf {
            $std::storage::vector_push(
                child::children,
                $std::storage::vector_remove(sibling::children, 0)
            );
        };
    },
    delete_node: fn(self, current: Number, key?) -> Bool {
        let node = BTree::node(self, current);
        let index = BTree::lower(self, node, key);
        let length = $std::storage::vector_size(node::keys);
        if index < length {
            if BTree::equal(
                self,
                $std::storage::vector_get(node::keys, index),
                key
            ) {
                if node::leaf {
                    $std::storage::vector_remove(node::keys, index);
                    $std::storage::vector_remove(node::values, index);
                    return true;
                };
                let left_index = $std::storage::vector_get(
                    node::children,
                    index
                );
                let right_index = $std::storage::vector_get(
                    node::children,
                    index + 1
                );
                if $std::storage::vector_size(
                    BTree::node(self, left_index)::keys
                ) >= self::degree {
                    let previous = BTree::extreme(self, left_index, true);
                    $std::storage::vector_set(
                        node::keys,
                        index,
                        previous::key
                    );
                    $std::storage::vector_set(
                        node::values,
                        index,
                        previous::value
                    );
                    return BTree::delete_node(self, left_index, previous::key);
                };
                if $std::storage::vector_size(
                    BTree::node(self, right_index)::keys
                ) >= self::degree {
                    let next = BTree::extreme(self, right_index, false);
                    $std::storage::vector_set(node::keys, index, next::key);
                    $std::storage::vector_set(
                        node::values,
                        index,
                        next::value
                    );
                    return BTree::delete_node(self, right_index, next::key);
                };
                let merged = BTree::merge(self, current, index);
                return BTree::delete_node(self, merged, key);
            };
        };
        if node::leaf {
            return false;
        };
        let child_index = $std::storage::vector_get(node::children, index);
        if $std::storage::vector_size(BTree::node(self, child_index)::keys)
            < self::degree {
            if index > 0 {
                let sibling = BTree::node(
                    self,
                    $std::storage::vector_get(node::children, index - 1)
                );
                if $std::storage::vector_size(sibling::keys) >= self::degree {
                    BTree::borrow_left(self, current, index);
                    return BTree::delete_node(self, child_index, key);
                };
            };
            if index < length {
                let sibling = BTree::node(
                    self,
                    $std::storage::vector_get(node::children, index + 1)
                );
                if $std::storage::vector_size(sibling::keys) >= self::degree {
                    BTree::borrow_right(self, current, index);
                    return BTree::delete_node(self, child_index, key);
                };
                child_index = BTree::merge(self, current, index);
            } else {
                child_index = BTree::merge(self, current, index - 1);
            };
        };
        BTree::delete_node(self, child_index, key)
    },
    remove: fn(self, key?) {
        let removed = BTree::delete_node(self, self::root, key);
        let root = BTree::node(self, self::root);
        if not root::leaf and $std::storage::vector_size(root::keys) == 0 {
            let previous = self::root;
            self::root = $std::storage::vector_get(root::children, 0);
            BTree::retire(self, previous);
        };
        if removed {
            self::count = self::count - 1;
        };
        removed
    },
    visit: fn(self, current: Number, output) {
        let node = BTree::node(self, current);
        let length = $std::storage::vector_size(node::keys);
        for index in $std::ranges::sequence(0, length, 1) {
            if not node::leaf {
                BTree::visit(
                    self,
                    $std::storage::vector_get(node::children, index),
                    output
                );
            };
            $std::storage::vector_push(
                output,
                scope {
                    key?: $std::storage::vector_get(node::keys, index),
                    value?: $std::storage::vector_get(node::values, index),
                }
            );
        };
        if not node::leaf {
            BTree::visit(
                self,
                $std::storage::vector_get(node::children, length),
                output
            );
        };
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(BTree::entries(self)) },
    entries: fn(self) {
        let output = $std::storage::vector_empty(
            decltype($std::ranges::front(entry_seed(self::key_seed, self::value_seed)))
        );
        BTree::visit(self, self::root, output);
        $std::storage::vector_take(output)
    },
    visit_range: fn(self, current: Number, low?, high?, output) {
        let node = BTree::node(self, current);
        let first = BTree::lower(self, node, low);
        let length = $std::storage::vector_size(node::keys);
        if not node::leaf {
            BTree::visit_range(
                self,
                $std::storage::vector_get(node::children, first),
                low,
                high,
                output
            );
        };
        for index in $std::ranges::sequence(first, length, 1) {
            let key? = $std::storage::vector_get(node::keys, index);
            if not self::order::less(key, high) {
                return;
            };
            $std::storage::vector_push(
                output,
                scope {
                    key?: key,
                    value?: $std::storage::vector_get(node::values, index),
                }
            );
            if not node::leaf {
                BTree::visit_range(
                    self,
                    $std::storage::vector_get(node::children, index + 1),
                    low,
                    high,
                    output
                );
            };
        };
    },
    range: fn(self, low?, high?) {
        let output = $std::storage::vector_empty(
            decltype($std::ranges::front(entry_seed(self::key_seed, self::value_seed)))
        );
        if self::order::less(low, high) {
            BTree::visit_range(self, self::root, low, high, output);
        };
        $std::storage::vector_take(output)
    },
    validate_walk: fn(self, current: Number, root: Bool, depth: Number, state)
        -> Null {
        let node = BTree::node(self, current);
        let length = $std::storage::vector_size(node::keys);
        state::nodes = state::nodes + 1;
        if length > 2 * self::degree - 1
            or (not root
            and length < self::degree - 1)
            or $std::storage::vector_size(node::values) != length {
            state::valid = false;
            return;
        };
        if node::leaf {
            if $std::storage::vector_size(node::children) != 0 {
                state::valid = false;
                return;
            };
            if state::depth < 0 {
                state::depth = depth;
            } else {
                if state::depth != depth {
                    state::valid = false;
                };
            };
        } else {
            if length == 0
                or $std::storage::vector_size(node::children) != length + 1 {
                state::valid = false;
                return;
            };
        };
        for index in $std::ranges::sequence(0, length, 1) {
            if not node::leaf {
                BTree::validate_walk(
                    self,
                    $std::storage::vector_get(node::children, index),
                    false,
                    depth + 1,
                    state
                );
            };
            let key? = $std::storage::vector_get(node::keys, index);
            if state::count == 0 {
                $std::storage::vector_push(state::previous, key);
            } else {
                if not self::order::less($std::storage::vector_get(state::previous, 0), key) {
                    state::valid = false;
                };
                $std::storage::vector_set(state::previous, 0, key);
            };
            state::count = state::count + 1;
        };
        if not node::leaf {
            BTree::validate_walk(
                self,
                $std::storage::vector_get(node::children, length),
                false,
                depth + 1,
                state
            );
        };
    },
    validate: fn(self) {
        let state = scope {
            valid: true,
            count: 0,
            depth: -1,
            nodes: 0,
            previous: $std::storage::vector_empty(decltype($std::ranges::front(self::key_seed))),
        };
        BTree::validate_walk(self, self::root, true, 0, state);
        state::valid
            and state::count == self::count
            and state::nodes == $std::slots::count(self::nodes)
    },
    height: fn(self) {
        let current = self::root;
        let depth = 1;
        loop {
            let node = BTree::node(self, current);
            if node::leaf {
                return depth;
            };
            current = $std::storage::vector_get(node::children, 0);
            depth = depth + 1;
        }
    },
    page_count: fn(self) {
        $std::slots::count(self::nodes)
    },
    clear: fn(self) {
        let root = BTree::node(self, self::root);
        $std::storage::vector_clear(root::keys);
        $std::storage::vector_clear(root::values);
        $std::storage::vector_clear(root::children);
        root::leaf = true;
        $std::slots::reset(self::nodes, root);
        self::root = 0;
        self::count = 0;
    },
};

# Internal pages contain separator keys only; values stay in linked leaf pages.
scope BPlusTree {
    new: fn(key_prototype?, value_prototype?) {
        BPlusTree::with_policy(
            key_prototype,
            value_prototype,
            scope {
                Self: decltype(key_prototype),
                sample?: key_prototype,
                less: NaturalOrder::less,
            }
        )
    },
    with_policy: fn(
        key_prototype?,
        value_prototype?,
        order: $std::concepts::StrictOrder
    ) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(decltype(key_prototype)),
            $std::ranges::empty_of(decltype(value_prototype)),
            order, key_prototype, value_prototype
        )
    },
    of_types: fn(key: Type, value: Type) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope { Self: key, sample?: null, less: NaturalOrder::less },
            null, null
        )
    },
    of_types_with: fn(key: Type, value: Type, order: $std::concepts::StrictOrder) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(key), $std::ranges::empty_of(value), order, null, null
        )
    },
    from_seeds: fn(keys: Range, values: Range, order: $std::concepts::StrictOrder,
        key_prototype?, value_prototype?) {
        let key_seed = $std::ranges::take(keys, 0);
        let value_seed = $std::ranges::take(values, 0);
        let first = scope {
            leaf: true,
            keys: $std::storage::vector_empty(decltype($std::ranges::front(key_seed))),
            values: $std::storage::vector_empty(decltype($std::ranges::front(value_seed))),
            children: $std::storage::vector_empty(Number),
            next: -1,
        };
        let nodes = $std::slots::new(decltype(first));
        let root = $std::slots::allocate(nodes, first);
        scope {
            nodes: nodes,
            root: root,
            count: 0,
            degree: 8,
            order: order,
            key_seed: key_seed,
            value_seed: value_seed,
            key_prototype?: key_prototype,
            value_prototype?: value_prototype,
        }
    },
    node: fn(self, index: Number) {
        $std::slots::get(self::nodes, index)
    },
    allocate: fn(self, leaf: Bool) -> Number {
        let node = scope {
            leaf: leaf,
            keys: $std::storage::vector_empty(decltype($std::ranges::front(self::key_seed))),
            values: $std::storage::vector_empty(decltype($std::ranges::front(self::value_seed))),
            children: $std::storage::vector_empty(Number),
            next: -1,
        };
        $std::slots::allocate(self::nodes, node)
    },
    retire: fn(self, index: Number) {
        $std::slots::release(self::nodes, index);
    },
    equal: fn(self, left?, right?) {
        not self::order::less(left, right) and not self::order::less(
            right,
            left
        )
    },
    lower: fn(self, node, key?) {
        let low = 0;
        let high = $std::storage::vector_size(node::keys);
        loop {
            if low >= high {
                break;
            };
            let middle = $std::math::floor((low + high) / 2);
            if self::order::less(
                $std::storage::vector_get(node::keys, middle),
                key
            ) {
                low = middle + 1;
            } else {
                high = middle;
            };
        };
        low
    },
    child_position: fn(self, node, key?) {
        let index = BPlusTree::lower(self, node, key);
        if index < $std::storage::vector_size(node::keys) {
            if BPlusTree::equal(
                self,
                $std::storage::vector_get(node::keys, index),
                key
            ) {
                index = index + 1;
            };
        };
        index
    },
    descend: fn(self, key?, path) {
        let current = self::root;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return current;
            };
            let index = BPlusTree::child_position(self, node, key);
            $std::storage::vector_push(
                path,
                scope {
                    node: current,
                    index: index
                }
            );
            current = $std::storage::vector_get(node::children, index);
        }
    },
    leaf: fn(self, key?) {
        let path = $std::storage::vector_empty(decltype(scope { node: 0, index: 0 }));
        BPlusTree::descend(self, key, path)
    },
    get: fn(self, key?) {
        let node = BPlusTree::node(self, BPlusTree::leaf(self, key));
        let index = BPlusTree::lower(self, node, key);
        if index < $std::storage::vector_size(node::keys) {
            if BPlusTree::equal(
                self,
                $std::storage::vector_get(node::keys, index),
                key
            ) {
                return $std::data::Option::some(
                    $std::storage::vector_get(node::values, index)
                );
            };
        };
        null
    },
    contains: fn(self, key?) {
        BPlusTree::get(self, key) is not null
    },
    size: fn(self) {
        self::count
    },
    is_empty: fn(self) {
        self::count == 0
    },
    split: fn(self, current: Number) {
        let left = BPlusTree::node(self, current);
        let right_index = BPlusTree::allocate(self, left::leaf);
        let right = BPlusTree::node(self, right_index);
        let middle = self::degree;
        let length = $std::storage::vector_size(left::keys);
        let separator? = $std::storage::vector_get(left::keys, middle);
        let first = if left::leaf {
            middle
        } else {
            middle + 1
        };
        for index in $std::ranges::sequence(first, length, 1) {
            $std::storage::vector_push(
                right::keys,
                $std::storage::vector_get(left::keys, index)
            );
            if left::leaf {
                $std::storage::vector_push(
                    right::values,
                    $std::storage::vector_get(left::values, index)
                );
            };
        };
        if left::leaf {
            right::next = left::next;
            left::next = right_index;
            for index in $std::ranges::sequence(middle, length, 1) {
                $std::storage::vector_pop(left::values);
            };
        } else {
            let children = $std::storage::vector_size(left::children);
            for index in $std::ranges::sequence(middle + 1, children, 1) {
                $std::storage::vector_push(
                    right::children,
                    $std::storage::vector_get(left::children, index)
                );
            };
            for index in $std::ranges::sequence(middle + 1, children, 1) {
                $std::storage::vector_pop(left::children);
            };
        };
        for index in $std::ranges::sequence(middle, length, 1) {
            $std::storage::vector_pop(left::keys);
        };
        scope {
            key?: separator,
            right: right_index
        }
    },
    insert: fn(self, key?, value?) {
        let path = $std::storage::vector_empty(decltype(scope { node: 0, index: 0 }));
        let current = BPlusTree::descend(self, key, path);
        let node = BPlusTree::node(self, current);
        let index = BPlusTree::lower(self, node, key);
        if index < $std::storage::vector_size(node::keys) {
            if BPlusTree::equal(
                self,
                $std::storage::vector_get(node::keys, index),
                key
            ) {
                $std::storage::vector_set(node::values, index, value);
                return false;
            };
        };
        $std::storage::vector_insert(node::keys, index, key);
        $std::storage::vector_insert(node::values, index, value);
        self::count = self::count + 1;
        loop {
            let page = BPlusTree::node(self, current);
            if $std::storage::vector_size(page::keys) <= 2 * self::degree - 1 {
                break;
            };
            let split = BPlusTree::split(self, current);
            if $std::storage::vector_size(path) == 0 {
                let root = BPlusTree::allocate(self, false);
                let parent = BPlusTree::node(self, root);
                $std::storage::vector_push(parent::keys, split::key);
                $std::storage::vector_push(parent::children, current);
                $std::storage::vector_push(parent::children, split::right);
                self::root = root;
                break;
            };
            let entry = $std::storage::vector_pop(path);
            let parent = BPlusTree::node(self, entry::node);
            $std::storage::vector_insert(
                parent::keys,
                entry::index,
                split::key
            );
            $std::storage::vector_insert(
                parent::children,
                entry::index + 1,
                split::right
            );
            current = entry::node;
        };
        true
    },
    refresh_minimum: fn(self, path, minimum?) {
        loop {
            if $std::storage::vector_size(path) == 0 {
                break;
            };
            let entry = $std::storage::vector_pop(path);
            if entry::index > 0 {
                $std::storage::vector_set(
                    BPlusTree::node(self, entry::node)::keys,
                    entry::index - 1,
                    minimum
                );
                break;
            };
        };
    },
    borrow_left: fn(self, parent, index: Number, child, sibling) {
        if child::leaf {
            $std::storage::vector_insert(
                child::keys,
                0,
                $std::storage::vector_pop(sibling::keys)
            );
            $std::storage::vector_insert(
                child::values,
                0,
                $std::storage::vector_pop(sibling::values)
            );
            $std::storage::vector_set(
                parent::keys,
                index - 1,
                $std::storage::vector_get(child::keys, 0)
            );
        } else {
            $std::storage::vector_insert(
                child::keys,
                0,
                $std::storage::vector_get(parent::keys, index - 1)
            );
            $std::storage::vector_insert(
                child::children,
                0,
                $std::storage::vector_pop(sibling::children)
            );
            $std::storage::vector_set(
                parent::keys,
                index - 1,
                $std::storage::vector_pop(sibling::keys)
            );
        };
    },
    borrow_right: fn(self, parent, index: Number, child, sibling) {
        if child::leaf {
            $std::storage::vector_push(
                child::keys,
                $std::storage::vector_remove(sibling::keys, 0)
            );
            $std::storage::vector_push(
                child::values,
                $std::storage::vector_remove(sibling::values, 0)
            );
            $std::storage::vector_set(
                parent::keys,
                index,
                $std::storage::vector_get(sibling::keys, 0)
            );
        } else {
            $std::storage::vector_push(
                child::keys,
                $std::storage::vector_get(parent::keys, index)
            );
            $std::storage::vector_push(
                child::children,
                $std::storage::vector_remove(sibling::children, 0)
            );
            $std::storage::vector_set(
                parent::keys,
                index,
                $std::storage::vector_remove(sibling::keys, 0)
            );
        };
    },
    merge: fn(self, parent, index: Number) {
        let left_index = $std::storage::vector_get(parent::children, index);
        let right_index = $std::storage::vector_get(
            parent::children,
            index + 1
        );
        let left = BPlusTree::node(self, left_index);
        let right = BPlusTree::node(self, right_index);
        if left::leaf {
            left::next = right::next;
        } else {
            $std::storage::vector_push(
                left::keys,
                $std::storage::vector_get(parent::keys, index)
            );
        };
        let keys = right::keys;
        for item in $std::ranges::sequence(0, $std::storage::vector_size(keys), 1) {
            $std::storage::vector_push(left::keys, $std::storage::vector_get(keys, item));
        };
        let values = right::values;
        for item in $std::ranges::sequence(0, $std::storage::vector_size(values), 1) {
            $std::storage::vector_push(left::values, $std::storage::vector_get(values, item));
        };
        let children = right::children;
        for item in $std::ranges::sequence(0, $std::storage::vector_size(children), 1) {
            $std::storage::vector_push(left::children, $std::storage::vector_get(children, item));
        };
        $std::storage::vector_remove(parent::keys, index);
        $std::storage::vector_remove(parent::children, index + 1);
        BPlusTree::retire(self, right_index);
        left_index
    },
    remove: fn(self, key?) {
        let path = $std::storage::vector_empty(decltype(scope { node: 0, index: 0 }));
        let current = BPlusTree::descend(self, key, path);
        let leaf = BPlusTree::node(self, current);
        let index = BPlusTree::lower(self, leaf, key);
        if index == $std::storage::vector_size(leaf::keys) {
            return false;
        };
        if not BPlusTree::equal(
            self,
            $std::storage::vector_get(leaf::keys, index),
            key
        ) {
            return false;
        };
        $std::storage::vector_remove(leaf::keys, index);
        $std::storage::vector_remove(leaf::values, index);
        self::count = self::count - 1;
        if current == self::root {
            return true;
        };
        let changed = index == 0;
        let minimum? = $std::storage::vector_get(leaf::keys, 0);
        loop {
            if $std::storage::vector_size(path) == 0 {
                break;
            };
            let entry = $std::storage::vector_pop(path);
            let parent = BPlusTree::node(self, entry::node);
            let child = BPlusTree::node(self, current);
            if changed and entry::index > 0 {
                $std::storage::vector_set(
                    parent::keys,
                    entry::index - 1,
                    minimum
                );
                changed = false;
            };
            if $std::storage::vector_size(child::keys) >= self::degree - 1 {
                if changed {
                    BPlusTree::refresh_minimum(self, path, minimum);
                };
                break;
            };
            if entry::index > 0 {
                let sibling = BPlusTree::node(
                    self,
                    $std::storage::vector_get(
                        parent::children,
                        entry::index - 1
                    )
                );
                if $std::storage::vector_size(sibling::keys) >= self::degree {
                    BPlusTree::borrow_left(
                        self,
                        parent,
                        entry::index,
                        child,
                        sibling
                    );
                    break;
                };
            };
            if entry::index < $std::storage::vector_size(parent::keys) {
                let sibling = BPlusTree::node(
                    self,
                    $std::storage::vector_get(
                        parent::children,
                        entry::index + 1
                    )
                );
                if $std::storage::vector_size(sibling::keys) >= self::degree {
                    BPlusTree::borrow_right(
                        self,
                        parent,
                        entry::index,
                        child,
                        sibling
                    );
                    if changed {
                        BPlusTree::refresh_minimum(self, path, minimum);
                    };
                    break;
                };
                BPlusTree::merge(self, parent, entry::index);
            } else {
                BPlusTree::merge(self, parent, entry::index - 1);
            };
            current = entry::node;
        };
        let root = BPlusTree::node(self, self::root);
        if not root::leaf and $std::storage::vector_size(root::keys) == 0 {
            let previous = self::root;
            self::root = $std::storage::vector_get(root::children, 0);
            BPlusTree::retire(self, previous);
        };
        true
    },
    first_leaf: fn(self) {
        let current = self::root;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return current;
            };
            current = $std::storage::vector_get(node::children, 0);
        }
    },
    collect: fn(self, current: Number, first: Number, output) {
        let page = current;
        let start = first;
        loop {
            let node = BPlusTree::node(self, page);
            for index in $std::ranges::sequence(
                start,
                $std::storage::vector_size(node::keys),
                1
            ) {
                $std::storage::vector_push(
                    output,
                    scope {
                        key?: $std::storage::vector_get(node::keys, index),
                        value?: $std::storage::vector_get(node::values, index),
                    }
                );
            };
            if node::next < 0 {
                break;
            };
            page = node::next;
            start = 0;
        };
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(BPlusTree::entries(self)) },
    entries: fn(self) {
        let output = $std::storage::vector_empty(
            decltype($std::ranges::front(entry_seed(self::key_seed, self::value_seed)))
        );
        BPlusTree::collect(self, BPlusTree::first_leaf(self), 0, output);
        $std::storage::vector_take(output)
    },
    range: fn(self, low?, high?) {
        let output = $std::storage::vector_empty(
            decltype($std::ranges::front(entry_seed(self::key_seed, self::value_seed)))
        );
        if self::order::less(low, high) {
            let page = BPlusTree::leaf(self, low);
            let start = BPlusTree::lower(
                self,
                BPlusTree::node(self, page),
                low
            );
            loop {
                let node = BPlusTree::node(self, page);
                for index in $std::ranges::sequence(
                    start,
                    $std::storage::vector_size(node::keys),
                    1
                ) {
                    let key? = $std::storage::vector_get(node::keys, index);
                    if not self::order::less(key, high) {
                        return $std::storage::vector_take(output);
                    };
                    $std::storage::vector_push(
                        output,
                        scope {
                            key?: key,
                            value?: $std::storage::vector_get(
                                node::values,
                                index
                            ),
                        }
                    );
                };
                if node::next < 0 {
                    break;
                };
                page = node::next;
                start = 0;
            };
        };
        $std::storage::vector_take(output)
    },
    minimum: fn(self, current: Number) {
        let page = current;
        loop {
            let node = BPlusTree::node(self, page);
            if node::leaf {
                return $std::storage::vector_get(node::keys, 0);
            };
            page = $std::storage::vector_get(node::children, 0);
        }
    },
    validate_walk: fn(self, current: Number, root: Bool, depth: Number, state)
        -> Null {
        let node = BPlusTree::node(self, current);
        let length = $std::storage::vector_size(node::keys);
        state::nodes = state::nodes + 1;
        if length > 2 * self::degree - 1
            or (not root
            and length < self::degree - 1) {
            state::valid = false;
            return;
        };
        if node::leaf {
            if $std::storage::vector_size(node::children) != 0
                or $std::storage::vector_size(node::values) != length {
                state::valid = false;
                return;
            };
            if state::depth < 0 {
                state::depth = depth;
            } else {
                if state::depth != depth {
                    state::valid = false;
                };
            };
            if state::previous_leaf >= 0 {
                if BPlusTree::node(self, state::previous_leaf)::next != current {
                    state::valid = false;
                };
            };
            state::previous_leaf = current;
            let previous = state::previous;
            for index in $std::ranges::sequence(0, length, 1) {
                let key? = $std::storage::vector_get(node::keys, index);
                if state::count == 0 {
                    $std::storage::vector_push(previous, key);
                } else {
                    if not self::order::less($std::storage::vector_get(previous, 0), key) {
                        state::valid = false;
                    };
                    $std::storage::vector_set(previous, 0, key);
                };
                state::count = state::count + 1;
            };
        } else {
            if length == 0
                or $std::storage::vector_size(node::values) != 0
                or $std::storage::vector_size(node::children) != length + 1 {
                state::valid = false;
                return;
            };
            for index in $std::ranges::sequence(0, length + 1, 1) {
                let child = $std::storage::vector_get(node::children, index);
                BPlusTree::validate_walk(self, child, false, depth + 1, state);
                if index > 0 {
                    if not BPlusTree::equal(
                        self,
                        $std::storage::vector_get(node::keys, index - 1),
                        BPlusTree::minimum(self, child)
                    ) {
                        state::valid = false;
                    };
                };
            };
        };
    },
    validate: fn(self) {
        let state = scope {
            valid: true,
            count: 0,
            depth: -1,
            nodes: 0,
            previous: $std::storage::vector_empty(decltype($std::ranges::front(self::key_seed))),
            previous_leaf: -1,
        };
        BPlusTree::validate_walk(self, self::root, true, 0, state);
        state::valid
            and state::count == self::count
            and BPlusTree::node(self, state::previous_leaf)::next == -1
            and state::nodes == $std::slots::count(self::nodes)
    },
    height: fn(self) {
        let current = self::root;
        let depth = 1;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return depth;
            };
            current = $std::storage::vector_get(node::children, 0);
            depth = depth + 1;
        }
    },
    page_count: fn(self) {
        $std::slots::count(self::nodes)
    },
    clear: fn(self) {
        let root = BPlusTree::node(self, self::root);
        $std::storage::vector_clear(root::keys);
        $std::storage::vector_clear(root::values);
        $std::storage::vector_clear(root::children);
        root::leaf = true;
        root::next = -1;
        self::root = $std::slots::reset(self::nodes, root);
        self::count = 0;
    },
};

# The row indices below are private to the arena. The collection only exposes keys.
fn _set_find(self, key?) -> Number {
    let arena = self::arena;
    let index = $std::arena::root(arena);
    loop {
        if index == 0 { return 0; };
        let value? = $std::arena::key(arena, index);
        if self::order::less(key, value) {
            index = $std::arena::child(arena, index, true);
        } else {
            if self::order::less(value, key) {
                index = $std::arena::child(arena, index, false);
            } else {
                return index;
            };
        };
    }
};

# Mirroring the direction keeps insertion and removal repair identical.
fn _set_rotate(arena: Storage, index: Number, left: Bool) {
    let child = $std::arena::child(arena, index, not left);
    let middle = $std::arena::child(arena, child, left);
    let parent = $std::arena::parent(arena, index);
    $std::arena::set_child(arena, index, not left, middle);
    if middle != 0 { $std::arena::set_parent(arena, middle, index); };
    $std::arena::set_parent(arena, child, parent);
    if parent == 0 {
        $std::arena::set_root(arena, child);
    } else {
        let on_left = index == $std::arena::child(arena, parent, true);
        $std::arena::set_child(arena, parent, on_left, child);
    };
    $std::arena::set_child(arena, child, left, index);
    $std::arena::set_parent(arena, index, child);
};

fn _set_repair_insert(arena: Storage, inserted: Number) {
    let index = inserted;
    loop {
        let parent = $std::arena::parent(arena, index);
        if not $std::arena::red(arena, parent) { break; };
        let grand = $std::arena::parent(arena, parent);
        let on_left = parent == $std::arena::child(arena, grand, true);
        let uncle = $std::arena::child(arena, grand, not on_left);
        if $std::arena::red(arena, uncle) {
            $std::arena::set_red(arena, parent, false);
            $std::arena::set_red(arena, uncle, false);
            $std::arena::set_red(arena, grand, true);
            index = grand;
        } else {
            if index == $std::arena::child(arena, parent, not on_left) {
                index = parent;
                _set_rotate(arena, index, on_left);
            };
            let next_parent = $std::arena::parent(arena, index);
            let next_grand = $std::arena::parent(arena, next_parent);
            $std::arena::set_red(arena, next_parent, false);
            $std::arena::set_red(arena, next_grand, true);
            _set_rotate(arena, next_grand, not on_left);
        };
    };
    $std::arena::set_red(arena, $std::arena::root(arena), false);
};

fn _set_edge(arena: Storage, start: Number, left: Bool) -> Number {
    let index = start;
    loop {
        let child = $std::arena::child(arena, index, left);
        if child == 0 { return index; };
        index = child;
    }
};

fn _set_next(arena: Storage, start: Number) -> Number {
    let right = $std::arena::child(arena, start, false);
    if right != 0 { return _set_edge(arena, right, true); };
    let index = start;
    let parent = $std::arena::parent(arena, start);
    loop {
        if parent == 0 { return 0; };
        if index == $std::arena::child(arena, parent, true) { return parent; };
        index = parent;
        parent = $std::arena::parent(arena, index);
    }
};

fn _set_transplant(arena: Storage, removed: Number, replacement: Number) {
    let parent = $std::arena::parent(arena, removed);
    if parent == 0 {
        $std::arena::set_root(arena, replacement);
    } else {
        let on_left = removed == $std::arena::child(arena, parent, true);
        $std::arena::set_child(arena, parent, on_left, replacement);
    };
    $std::arena::set_parent(arena, replacement, parent);
};

fn _set_repair_remove(arena: Storage, removed: Number) {
    let index = removed;
    loop {
        if index == $std::arena::root(arena) or $std::arena::red(arena, index) {
            break;
        };
        let parent = $std::arena::parent(arena, index);
        let on_left = index == $std::arena::child(arena, parent, true);
        let sibling = $std::arena::child(arena, parent, not on_left);
        if $std::arena::red(arena, sibling) {
            $std::arena::set_red(arena, sibling, false);
            $std::arena::set_red(arena, parent, true);
            _set_rotate(arena, parent, on_left);
            sibling = $std::arena::child(arena, parent, not on_left);
        };
        let near = $std::arena::child(arena, sibling, on_left);
        let far = $std::arena::child(arena, sibling, not on_left);
        if not $std::arena::red(arena, near) and not $std::arena::red(arena, far) {
            $std::arena::set_red(arena, sibling, true);
            index = parent;
        } else {
            if not $std::arena::red(arena, far) {
                $std::arena::set_red(arena, near, false);
                $std::arena::set_red(arena, sibling, true);
                _set_rotate(arena, sibling, not on_left);
            };
            let next_sibling = $std::arena::child(arena, parent, not on_left);
            $std::arena::set_red(arena, next_sibling, $std::arena::red(arena, parent));
            $std::arena::set_red(arena, parent, false);
            let next_far = $std::arena::child(arena, next_sibling, not on_left);
            $std::arena::set_red(arena, next_far, false);
            _set_rotate(arena, parent, on_left);
            index = $std::arena::root(arena);
        };
    };
    $std::arena::set_red(arena, index, false);
};

fn _set_bound(self, key?) -> Number {
    let arena = self::arena;
    let index = $std::arena::root(arena);
    let candidate = 0;
    loop {
        if index == 0 { return candidate; };
        if self::order::less($std::arena::key(arena, index), key) {
            index = $std::arena::child(arena, index, false);
        } else {
            candidate = index;
            index = $std::arena::child(arena, index, true);
        };
    }
};

# Ordered Set with logarithmic point operations and an explicit comparison policy.
# Comparator-equivalent keys are unique; snapshots retain membership, not deep copies.
scope Set {
    new: fn(initial: Range | Type) {
        Set::with_policy(
            initial,
            scope {
                Self: decltype($std::ranges::front(construction_range(initial))),
                sample?: null,
                less: NaturalOrder::less,
            }
        )
    },
    empty: fn(prototype?) {
        Set::new($std::ranges::take([prototype], 0))
    },
    with_policy: fn(initial: Range | Type, order: $std::concepts::StrictOrder) {
        let source = construction_range(initial);
        let arena = $std::arena::new(decltype($std::ranges::front(source)));
        let self = scope { arena: arena, order: order };
        if not (decltype(initial) is Type) {
            for value? in $std::ranges::materialize(source) {
                Set::insert(self, value);
            };
        };
        self
    },
    size: fn(self) -> Number {
        $std::arena::size(self::arena)
    },
    is_empty: fn(self) -> Bool {
        Set::size(self) == 0
    },
    contains: fn(self, key?) -> Bool {
        _set_find(self, key) != 0
    },
    insert: fn(self, key?) -> Bool {
        let arena = self::arena;
        let parent = 0;
        let index = $std::arena::root(arena);
        let left = false;
        loop {
            if index == 0 { break; };
            parent = index;
            let value? = $std::arena::key(arena, index);
            if self::order::less(key, value) {
                left = true;
            } else {
                if not self::order::less(value, key) { return false; };
                left = false;
            };
            index = $std::arena::child(arena, index, left);
        };
        let inserted = $std::arena::allocate(arena, key, parent);
        if parent == 0 {
            $std::arena::set_root(arena, inserted);
        } else {
            $std::arena::set_child(arena, parent, left, inserted);
        };
        _set_repair_insert(arena, inserted);
        true
    },
    remove: fn(self, key?) -> Bool {
        let arena = self::arena;
        let removed = _set_find(self, key);
        if removed == 0 { return false; };
        let left = $std::arena::child(arena, removed, true);
        let right = $std::arena::child(arena, removed, false);
        let was_red = $std::arena::red(arena, removed);
        let replacement = 0;
        if left == 0 {
            replacement = right;
            _set_transplant(arena, removed, right);
        } else {
            if right == 0 {
                replacement = left;
                _set_transplant(arena, removed, left);
            } else {
                let successor = _set_edge(arena, right, true);
                was_red = $std::arena::red(arena, successor);
                replacement = $std::arena::child(arena, successor, false);
                if $std::arena::parent(arena, successor) == removed {
                    $std::arena::set_parent(arena, replacement, successor);
                } else {
                    _set_transplant(arena, successor, replacement);
                    $std::arena::set_child(arena, successor, false, right);
                    $std::arena::set_parent(arena, right, successor);
                };
                _set_transplant(arena, removed, successor);
                $std::arena::set_child(arena, successor, true, left);
                $std::arena::set_parent(arena, left, successor);
                $std::arena::set_red(arena, successor, $std::arena::red(arena, removed));
            };
        };
        if not was_red { _set_repair_remove(arena, replacement); };
        $std::arena::release(arena, removed);
        true
    },
    lower_bound: fn(self, key?) -> $std::concepts::Option? {
        let arena = self::arena;
        let index = _set_bound(self, key);
        if index == 0 { null } else { $std::data::Option::some($std::arena::key(arena, index)) }
    },
    get: fn(self, key?) -> $std::concepts::Option? {
        let arena = self::arena;
        let index = _set_find(self, key);
        if index == 0 { null } else { $std::data::Option::some($std::arena::key(arena, index)) }
    },
    first: fn(self) -> $std::concepts::Option? {
        let arena = self::arena;
        let root = $std::arena::root(arena);
        if root == 0 { null } else {
            $std::data::Option::some($std::arena::key(arena, _set_edge(arena, root, true)))
        }
    },
    last: fn(self) -> $std::concepts::Option? {
        let arena = self::arena;
        let root = $std::arena::root(arena);
        if root == 0 { null } else {
            $std::data::Option::some($std::arena::key(arena, _set_edge(arena, root, false)))
        }
    },
    pop_first: fn(self) -> $std::concepts::Option? {
        let arena = self::arena;
        let root = $std::arena::root(arena);
        if root == 0 { return null; };
        let value? = $std::arena::key(arena, _set_edge(arena, root, true));
        Set::remove(self, value);
        $std::data::Option::some(value)
    },
    pop_last: fn(self) -> $std::concepts::Option? {
        let arena = self::arena;
        let root = $std::arena::root(arena);
        if root == 0 { return null; };
        let value? = $std::arena::key(arena, _set_edge(arena, root, false));
        Set::remove(self, value);
        $std::data::Option::some(value)
    },
    extend: fn(self, values: Range) -> Number {
        let added = 0;
        for value? in values {
            if Set::insert(self, value) { added = added + 1; };
        };
        added
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(Set::snapshot(self)) },
    snapshot: fn(self) {
        let arena = self::arena;
        let output = $std::storage::vector_empty(decltype($std::arena::key(arena, 0)));
        let index = _set_edge(arena, $std::arena::root(arena), true);
        loop {
            if index == 0 { break; };
            $std::storage::vector_push(output, $std::arena::key(arena, index));
            index = _set_next(arena, index);
        };
        $std::storage::vector_take(output)
    },
    range: fn(self, lower?, upper?) {
        let arena = self::arena;
        let output = $std::storage::vector_empty(decltype($std::arena::key(arena, 0)));
        let index = _set_bound(self, lower);
        loop {
            if index == 0 { break; };
            let value? = $std::arena::key(arena, index);
            if not self::order::less(value, upper) { break; };
            $std::storage::vector_push(output, value);
            index = _set_next(arena, index);
        };
        $std::storage::vector_take(output)
    },
    clear: fn(self) {
        $std::arena::clear(self::arena);
    },
};

# Array-backed binary heap. The selected strict order defines priority: less(a,
# b) means a is removed before b. Equal-priority elements are not stable.
scope Heap {
    new: fn(initial: Range | Type) {
        Heap::with_policy(
            initial,
            scope {
                Self: decltype($std::ranges::front(construction_range(initial))),
                sample?: null,
                less: NaturalOrder::less,
            }
        )
    },
    empty: fn(prototype?) {
        Heap::new($std::ranges::take([prototype], 0))
    },
    with_policy: fn(initial: Range | Type, order: $std::concepts::StrictOrder) {
        let self = scope {
            items: if decltype(initial) is Type {
                $std::storage::vector_empty(initial)
            } else {
                $std::storage::vector_new(initial)
            },
            order: order,
        };
        if not (decltype(initial) is Type) {
            let index = $std::math::floor(Heap::size(self) / 2);
            loop {
                if index == 0 {
                    break;
                };
                index = index - 1;
                Heap::sift_down(self, index);
            };
        };
        self
    },
    size: fn(self) {
        $std::storage::vector_size(self::items)
    },
    is_empty: fn(self) {
        Heap::size(self) == 0
    },
    clear: fn(self) {
        $std::storage::vector_clear(self::items)
    },
    peek: fn(self) {
        if Heap::is_empty(self) {
            null
        } else {
            $std::storage::vector_get(self::items, 0)
        }
    },
    push: fn(self, value?) {
        let index = $std::storage::vector_push(self::items, value);
        Heap::sift_up(self, index);
    },
    pop: fn(self) {
        if Heap::is_empty(self) {
            return null;
        };
        Heap::remove_top(self)
    },
    remove_top: fn(self) {
        let first? = $std::storage::vector_get(self::items, 0);
        let last? = $std::storage::vector_pop(self::items);
        if not Heap::is_empty(self) {
            $std::storage::vector_set(self::items, 0, last);
            Heap::sift_down(self, 0);
        };
        first
    },
    replace_top: fn(self, value?) {
        if Heap::is_empty(self) {
            Heap::push(self, value);
            return null;
        };
        let first? = $std::storage::vector_get(self::items, 0);
        $std::storage::vector_set(self::items, 0, value);
        Heap::sift_down(self, 0);
        first
    },
    push_pop: fn(self, value?) {
        if Heap::is_empty(self) {
            return value;
        };
        let first? = $std::storage::vector_get(self::items, 0);
        if self::order::less(first, value) {
            $std::storage::vector_set(self::items, 0, value);
            Heap::sift_down(self, 0);
            first
        } else {
            value
        }
    },
    extend: fn(self, values: Range) {
        for value? in values {
            Heap::push(self, value);
        };
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(Heap::snapshot(self)) },
    snapshot: fn(self) {
        $std::storage::vector_snapshot(self::items)
    },
    drain: fn(self) {
        let result = $std::storage::vector_empty_like(self::items);
        loop {
            if Heap::is_empty(self) {
                break;
            };
            $std::storage::vector_push(result, Heap::remove_top(self));
        };
        $std::storage::vector_take(result)
    },
    sorted: fn(self) {
        let copy = Heap::with_policy(Heap::snapshot(self), self::order);
        Heap::drain(copy)
    },
    validate: fn(self) -> Bool {
        let count = Heap::size(self);
        let index = 1;
        loop {
            if index >= count {
                break;
            };
            let parent = $std::math::floor((index - 1) / 2);
            let value? = $std::storage::vector_get(self::items, index);
            let above? = $std::storage::vector_get(self::items, parent);
            if self::order::less(value, above) {
                return false;
            };
            index = index + 1;
        };
        true
    },
    sift_up: fn(self, index: Number) {
        let value? = $std::storage::vector_get(self::items, index);
        loop {
            if index == 0 {
                break;
            };
            let parent = $std::math::floor((index - 1) / 2);
            let above? = $std::storage::vector_get(self::items, parent);
            if not self::order::less(value, above) {
                break;
            };
            $std::storage::vector_set(self::items, index, above);
            index = parent;
        };
        $std::storage::vector_set(self::items, index, value);
    },
    sift_down: fn(self, index: Number) {
        let count = Heap::size(self);
        let value? = $std::storage::vector_get(self::items, index);
        loop {
            let child = index * 2 + 1;
            if child >= count {
                break;
            };
            if child + 1 < count {
                let left? = $std::storage::vector_get(self::items, child);
                let right? = $std::storage::vector_get(
                    self::items,
                    child + 1
                );
                if self::order::less(right, left) {
                    child = child + 1;
                }
            };
            let below? = $std::storage::vector_get(self::items, child);
            if not self::order::less(below, value) {
                break;
            };
            $std::storage::vector_set(self::items, index, below);
            index = child;
        };
        $std::storage::vector_set(self::items, index, value);
    },
};
