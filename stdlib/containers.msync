# Canonical families keep instance data separate from shared operations.
# A storage policy may choose buffering, but retained state is always a snapshot.
scope SnapshotStorage {
    snapshot: fn(values: Range) -> Range {
        $std::ranges::materialize(values)
    },
};

fn construction_range(initial: Range | Type) {
    if decltype(initial) is Type {
        $std::ranges::empty_of(initial)
    } else {
        initial
    }
};

fn entry_seed(keys: Range, values: Range) {
    $std::ranges::transform($std::ranges::zip(keys, values), fn(pair) {
        scope { key?: pair::first, value?: pair::second }
    })
};

scope List {
    new: fn(initial: Range | Type) {
        List::with_storage(construction_range(initial), SnapshotStorage)
    },
    with_storage: fn(initial: Range | Type, storage: $std::concepts::RangeStorage) {
        scope {
            items: $std::ranges::materialize(storage::snapshot(construction_range(initial))),
            storage: storage,
        }
    },
    empty: fn(prototype?) {
        List::new($std::ranges::take([prototype], 0))
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        $std::ranges::materialize(self::items)
    },
    size: fn(self) {
        $std::ranges::size(self::items)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::items)
    },
    clear: fn(self) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::items, 0))
        );
    },
    get: fn(self, index: Number) {
        $std::ranges::at_or(self::items, index, null)
    },
    get_or: fn(self, index: Number, fallback?) {
        $std::ranges::at_or(self::items, index, fallback)
    },
    push: fn(self, value?) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::concat(self::items, [value]))
        );
    },
    extend: fn(self, values: Range) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::concat(self::items, values))
        );
    },
    insert: fn(self, index: Number, value?) {
        if index < 0 or index > List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::concat(
                        [value],
                        $std::ranges::drop(self::items, index)
                    )
                )
            )
        );
        true
    },
    set: fn(self, index: Number, value?) {
        if index < 0 or index >= List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::concat(
                        [value],
                        $std::ranges::drop(self::items, index + 1)
                    )
                )
            )
        );
        true
    },
    remove: fn(self, index: Number) {
        if index < 0 or index >= List::size(self) {
            return false;
        };
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::items, index),
                    $std::ranges::drop(self::items, index + 1)
                )
            )
        );
        true
    },
    remove_where: fn(self, predicate: Function) {
        let previous = List::size(self);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(self::items, predicate)
            )
        );
        previous - List::size(self)
    },
    contains: fn(self, value?) {
        $std::ranges::contains(self::items, value)
    },
    index_of: fn(self, value?) {
        $std::ranges::index_of(self::items, value)
    },
    slice: fn(self, start: Number, count: Number) {
        $std::ranges::materialize(
            $std::ranges::slice(self::items, start, count)
        )
    },
    reverse: fn(self) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::reverse(self::items))
        );
    },
    sort_with: fn(self, less: Function) {
        self::items = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::sort_with(self::items, less))
        );
    },
};

# Null is the absent alternative, outside a concrete comparison carrier.
scope Equivalence {
    same: fn(left?, right?) {
        if left is null {
            right is null
        } else {
            if right is null {
                false
            } else {
                left == right
            }
        }
    },
    test: fn(policy: $std::concepts::Equality, left?, right?) {
        if left is null {
            right is null
        } else {
            if right is null {
                false
            } else {
                policy::equal(left, right)
            }
        }
    },
};

scope EqualitySet {
    new: fn(initial: Range | Type) {
        let source = construction_range(initial);
        EqualitySet::with_policy(
            source,
            scope {
                Self: decltype($std::ranges::front(source)),
                equal: Equivalence::same,
            },
            SnapshotStorage
        )
    },
    with_equality: fn(initial: Range | Type, equality: $std::concepts::Equality) {
        EqualitySet::with_policy(initial, equality, SnapshotStorage)
    },
    with_policy: fn(
        initial: Range | Type,
        equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage
    ) {
        let source = $std::ranges::materialize(construction_range(initial));
        let self = scope {
            items: $std::ranges::materialize($std::ranges::take(source, 0)),
            equality: equality,
            storage: storage,
        };
        for value in source {
            EqualitySet::insert(self, value);
        };
        self
    },
    empty: fn(prototype?) {
        EqualitySet::new($std::ranges::take([prototype], 0))
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        $std::ranges::materialize(self::items)
    },
    size: fn(self) {
        $std::ranges::size(self::items)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::items)
    },
    clear: fn(self) {
        List::clear(self)
    },
    contains: fn(self, value?) {
        $std::ranges::any(
            self::items,
            fn(item?) {
                Equivalence::test(self::equality, item, value)
            }
        )
    },
    insert: fn(self, value?) {
        if EqualitySet::contains(self, value) {
            return false;
        };
        List::push(self, value);
        true
    },
    remove: fn(self, value?) {
        let previous = EqualitySet::size(self);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(
                    self::items,
                    fn(item?) {
                        Equivalence::test(self::equality, item, value)
                    }
                )
            )
        );
        previous != EqualitySet::size(self)
    },
    union_with: fn(self, other: Range) {
        for value in other {
            EqualitySet::insert(self, value);
        };
    },
    intersect_with: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::filter(
                    self::items,
                    fn(item?) {
                        $std::ranges::any(
                            values,
                            fn(value?) {
                                Equivalence::test(self::equality, item, value)
                            }
                        )
                    }
                )
            )
        );
    },
    except_with: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        self::items = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::reject(
                    self::items,
                    fn(item?) {
                        $std::ranges::any(
                            values,
                            fn(value?) {
                                Equivalence::test(self::equality, item, value)
                            }
                        )
                    }
                )
            )
        );
    },
    is_subset_of: fn(self, other: Range) {
        let values = $std::ranges::materialize(other);
        $std::ranges::all_of(
            self::items,
            fn(item?) {
                $std::ranges::any(
                    values,
                    fn(value?) {
                        Equivalence::test(self::equality, item, value)
                    }
                )
            }
        )
    },
    overlaps: fn(self, other: Range) {
        $std::ranges::any(
            other,
            fn(value?) {
                EqualitySet::contains(self, value)
            }
        )
    },
};

scope Map {
    new: fn(initial: Range) {
        Map::with_policy(
            initial,
            scope {
                Self: decltype($std::ranges::front(initial)::key),
                equal: Equivalence::same,
            },
            SnapshotStorage
        )
    },
    with_equality: fn(initial: Range, equality: $std::concepts::Equality) {
        Map::with_policy(initial, equality, SnapshotStorage)
    },
    with_policy: fn(
        initial: Range,
        equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage
    ) {
        let source = $std::ranges::materialize(initial);
        let empty = $std::ranges::take(source, 0);
        let self = Map::from_seeds(
            $std::ranges::transform(empty, fn(entry) { entry::key }),
            $std::ranges::transform(empty, fn(entry) { entry::value }),
            equality,
            storage
        );
        for entry in source {
            Map::insert(self, entry::key, entry::value);
        };
        self
    },
    from_seeds: fn(keys: Range, values: Range, equality: $std::concepts::Equality,
        storage: $std::concepts::RangeStorage) {
        scope {
            keys: $std::ranges::materialize(keys),
            values: $std::ranges::materialize(values),
            equality: equality,
            storage: storage,
        }
    },
    of_types: fn(key: Type, value: Type) {
        Map::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope { Self: key, equal: Equivalence::same },
            SnapshotStorage
        )
    },
    of_types_with: fn(key: Type, value: Type, equality: $std::concepts::Equality) {
        Map::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            equality,
            SnapshotStorage
        )
    },
    empty: fn(key_prototype?, value_prototype?) {
        Map::new(
            $std::ranges::take(
                [
                    scope {
                        key?: key_prototype,
                        value?: value_prototype
                    }
                ],
                0
            )
        )
    },
    empty_nullable: fn(key_prototype?, value_prototype?) {
        Map::new(
            $std::ranges::take(
                [
                    scope {
                        key?: key_prototype,
                        value?: value_prototype
                    },
                    scope {
                        key?: key_prototype,
                        value?: null
                    }
                ],
                0
            )
        )
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(Map::entries(self)) },
    entries: fn(self) {
        $std::ranges::materialize(
            $std::ranges::transform(
                $std::ranges::zip(self::keys, self::values),
                fn(pair) {
                    scope {
                        key?: pair::first,
                        value?: pair::second
                    }
                }
            )
        )
    },
    keys: fn(self) {
        $std::ranges::materialize(self::keys)
    },
    values: fn(self) {
        $std::ranges::materialize(self::values)
    },
    size: fn(self) {
        $std::ranges::size(self::keys)
    },
    is_empty: fn(self) {
        $std::ranges::empty(self::keys)
    },
    clear: fn(self) {
        self::keys = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::keys, 0))
        );
        self::values = $std::ranges::materialize(
            self::storage::snapshot($std::ranges::take(self::values, 0))
        );
    },
    locate: fn(self, key?) {
        $std::ranges::index_if(
            self::keys,
            fn(item?) {
                Equivalence::test(self::equality, item, key)
            }
        )
    },
    contains_key: fn(self, key?) {
        Map::locate(self, key) is not null
    },
    get: fn(self, key?) {
        Map::get_or(self, key, null)
    },
    get_or: fn(self, key?, fallback?) {
        let index? = Map::locate(self, key);
        if index is null {
            fallback
        } else {
            $std::ranges::at(self::values, index)
        }
    },
    insert: fn(self, key?, value?) {
        let index? = Map::locate(self, key);
        if index is null {
            self::keys = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(self::keys, [key])
                )
            );
            self::values = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(self::values, [value])
                )
            );
            true
        } else {
            self::values = $std::ranges::materialize(
                self::storage::snapshot(
                    $std::ranges::concat(
                        $std::ranges::take(self::values, index),
                        $std::ranges::concat(
                            [value],
                            $std::ranges::drop(self::values, index + 1)
                        )
                    )
                )
            );
            false
        }
    },
    try_insert: fn(self, key?, value?) {
        if Map::contains_key(self, key) {
            false
        } else {
            Map::insert(self, key, value)
        }
    },
    remove: fn(self, key?) {
        let index? = Map::locate(self, key);
        if index is null {
            return false;
        };
        self::keys = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::keys, index),
                    $std::ranges::drop(self::keys, index + 1)
                )
            )
        );
        self::values = $std::ranges::materialize(
            self::storage::snapshot(
                $std::ranges::concat(
                    $std::ranges::take(self::values, index),
                    $std::ranges::drop(self::values, index + 1)
                )
            )
        );
        true
    },
};

scope Stack {
    new: fn(initial: Range | Type) {
        List::new(initial)
    },
    with_storage: fn(initial: Range, storage: $std::concepts::RangeStorage) {
        List::with_storage(initial, storage)
    },
    empty: fn(prototype?) {
        List::empty(prototype)
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        List::snapshot(self)
    },
    size: fn(self) {
        List::size(self)
    },
    is_empty: fn(self) {
        List::is_empty(self)
    },
    clear: fn(self) {
        List::clear(self)
    },
    push: fn(self, value?) {
        List::push(self, value)
    },
    peek: fn(self) {
        if List::is_empty(self) {
            null
        } else {
            List::get(self, List::size(self) - 1)
        }
    },
    pop: fn(self) {
        if List::is_empty(self) {
            return null;
        };
        let index = List::size(self) - 1;
        let value? = List::get(self, index);
        List::remove(self, index);
        value
    },
};

scope Queue {
    new: fn(initial: Range | Type) {
        List::new(initial)
    },
    with_storage: fn(initial: Range, storage: $std::concepts::RangeStorage) {
        List::with_storage(initial, storage)
    },
    empty: fn(prototype?) {
        List::empty(prototype)
    },
    cursor: fn(self) { $std::ranges::Cursor::begin(self::items) },
    snapshot: fn(self) {
        List::snapshot(self)
    },
    size: fn(self) {
        List::size(self)
    },
    is_empty: fn(self) {
        List::is_empty(self)
    },
    clear: fn(self) {
        List::clear(self)
    },
    push: fn(self, value?) {
        List::push(self, value)
    },
    peek: fn(self) {
        List::get(self, 0)
    },
    pop: fn(self) {
        if List::is_empty(self) {
            return null;
        };
        let value? = List::get(self, 0);
        List::remove(self, 0);
        value
    },
};

# Container ordering treats Null first and all NaNs as one final equivalence
# class. Language Number comparison remains IEEE; Path ordering remains lexical.
scope NaturalOrder {
    less: fn(left?, right?) -> Bool {
        if left is null {
            return right is not null;
        };
        if right is null {
            return false;
        };
        if decltype(left) is Number {
            if left < right {
                return true;
            };
            if left >= right {
                return false;
            };
            return left == left and right != right;
        };
        left < right
    },
};

# Source-only sequence used for bounded page contents, traversal stacks and
# append-only snapshot assembly. Each link is an ordinary logical allocation.
scope _Chain {
    empty: fn(element: Type) {
        let link?: Scope = null;
        scope {
            first?: link,
            last?: link,
            count: 0,
            seed: $std::ranges::empty_of(element),
        }
    },
    node: fn(self, reference?) {
        let Item = decltype($std::ranges::front(self::seed));
        let value?: Item = null;
        let link?: Scope = null;
        let Node = decltype(scope { value?: value, previous?: link, next?: link });
        reference as Node?
    },
    size: fn(self) {
        self::count
    },
    clear: fn(self) {
        self::first = null;
        self::last = null;
        self::count = 0;
    },
    push: fn(self, value?) {
        let Item = decltype($std::ranges::front(self::seed));
        let typed: Item = value;
        let previous? = _Chain::node(self, self::last);
        let link?: Scope = null;
        let node = scope {
            value?: typed,
            previous?: previous,
            next?: link
        };
        if previous is not null {
            previous::next = node;
        } else {
            self::first = node;
        };
        self::last = node;
        let index = self::count;
        self::count = index + 1;
        index
    },
    at: fn(self, index: Number) {
        let position = 0;
        let node? = _Chain::node(self, self::first);
        loop {
            if node is null {
                return null;
            };
            if position == index {
                return node;
            };
            node = _Chain::node(self, node::next);
            position = position + 1;
        }
    },
    value: fn(self, node) {
        let Item = decltype($std::ranges::front(self::seed));
        let value? = node::value;
        if value is null {
            if $std::meta::accepts(Item, Null) { null }
            else { $std::ranges::front(self::seed) }
        } else { value as Item }
    },
    get: fn(self, index: Number) {
        let node? = _Chain::at(self, index);
        if node is null {
            $std::ranges::front(self::seed)
        } else {
            _Chain::value(self, node)
        }
    },
    set: fn(self, index: Number, value?) {
        let Item = decltype($std::ranges::front(self::seed));
        let typed: Item = value;
        let node? = _Chain::at(self, index);
        if node is null { $std::ranges::front(self::seed); return; };
        node::value = typed;
    },
    pop: fn(self) {
        let node? = _Chain::node(self, self::last);
        if node is null {
            return $std::ranges::front(self::seed);
        };
        self::last = node::previous;
        let previous? = _Chain::node(self, self::last);
        if previous is null {
            self::first = null;
        } else {
            previous::next = null;
        };
        self::count = self::count - 1;
        _Chain::value(self, node)
    },
    insert: fn(self, index: Number, value?) {
        let Item = decltype($std::ranges::front(self::seed));
        let typed: Item = value;
        if index == self::count {
            _Chain::push(self, value);
            return;
        };
        let next? = _Chain::at(self, index);
        if next is null {
            $std::ranges::front(self::seed); return;
        };
        let previous? = _Chain::node(self, next::previous);
        let node = scope {
            value?: typed,
            previous?: previous,
            next?: next
        };
        if previous is null {
            self::first = node;
        } else {
            previous::next = node;
        };
        next::previous = node;
        self::count = self::count + 1;
    },
    remove: fn(self, index: Number) {
        let node? = _Chain::at(self, index);
        if node is null {
            return $std::ranges::front(self::seed);
        };
        let previous? = _Chain::node(self, node::previous);
        let next? = _Chain::node(self, node::next);
        if previous is null {
            self::first = next;
        } else {
            previous::next = next;
        };
        if next is null {
            self::last = previous;
        } else {
            next::previous = previous;
        };
        self::count = self::count - 1;
        _Chain::value(self, node)
    },
    snapshot: fn(self) {
        let node? = _Chain::node(self, self::first);
        let values = $std::ranges::generate(
            self::count,
            fn(_) {
                if node is null {
                    return $std::ranges::front(self::seed);
                };
                let value? = _Chain::value(self, node);
                node = _Chain::node(self, node::next);
                value
            }
        );
        $std::ranges::materialize(values)
    },
    take: fn(self) {
        let values = _Chain::snapshot(self);
        _Chain::clear(self);
        values
    },
};

# Identity is tested only by explicit structure inspection, not tree operations.
fn _same_scope(left?, right?) {
    $std::ranges::contains([left], right)
};

scope BTree {
    new: fn(key_prototype?, value_prototype?) {
        BTree::with_policy(
            key_prototype,
            value_prototype,
            scope {
                Self: decltype(key_prototype),
                sample?: key_prototype,
                less: NaturalOrder::less,
            }
        )
    },
    with_policy: fn(
        key_prototype?,
        value_prototype?,
        order: $std::concepts::StrictOrder
    ) {
        BTree::from_seeds(
            $std::ranges::empty_of(decltype(key_prototype)),
            $std::ranges::empty_of(decltype(value_prototype)),
            order,
            key_prototype,
            value_prototype
        )
    },
    of_types: fn(key: Type, value: Type) {
        BTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope {
                Self: key,
                sample?: null,
                less: NaturalOrder::less
            },
            null,
            null
        )
    },
    of_types_with: fn(
        key: Type,
        value: Type,
        order: $std::concepts::StrictOrder
    ) {
        BTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            order,
            null,
            null
        )
    },
    from_seeds: fn(
        keys: Range,
        values: Range,
        order: $std::concepts::StrictOrder,
        key_prototype?,
        value_prototype?
    ) {
        let key_seed = $std::ranges::take(keys, 0);
        let value_seed = $std::ranges::take(values, 0);
        let first = BTree::page(key_seed, value_seed, true);
        let root = first;
        scope {
            pages: 1,
            root: root,
            count: 0,
            degree: 8,
            order: order,
            key_seed: key_seed,
            value_seed: value_seed,
            key_prototype?: key_prototype,
            value_prototype?: value_prototype,
        }
    },
    page: fn(key_seed: Range, value_seed: Range, leaf: Bool) {
        scope {
            leaf: leaf,
            keys: _Chain::empty(decltype($std::ranges::front(key_seed))),
            values: _Chain::empty(decltype($std::ranges::front(value_seed))),
            children: _Chain::empty(Scope),
        }
    },
    node: fn(self, node) {
        let Page = decltype(BTree::page(self::key_seed, self::value_seed, false));
        node as Page
    },
    new_page: fn(self, leaf: Bool) {
        self::pages = self::pages + 1;
        BTree::page(self::key_seed, self::value_seed, leaf)
    },
    retire: fn(self, node) {
        self::pages = self::pages - 1;
    },
    lower: fn(self, node, key?) {
        let node = BTree::node(self, node);
        let low = 0;
        let high = _Chain::size(node::keys);
        loop {
            if low >= high {
                break;
            };
            let middle = $std::math::floor((low + high) / 2);
            if self::order::less(_Chain::get(node::keys, middle), key) {
                low = middle + 1;
            } else {
                high = middle;
            };
        };
        low
    },
    equal: fn(self, left?, right?) {
        not self::order::less(left, right) and not self::order::less(
            right,
            left
        )
    },
    locate: fn(self, key?) {
        let current = self::root;
        loop {
            let node = BTree::node(self, current);
            let index = BTree::lower(self, node, key);
            if index < _Chain::size(node::keys) {
                if BTree::equal(self, _Chain::get(node::keys, index), key) {
                    return scope {
                        node: current,
                        index: index
                    };
                };
            };
            if node::leaf {
                return null;
            };
            current = _Chain::get(node::children, index);
        }
    },
    get: fn(self, key?) {
        let found? = BTree::locate(self, key);
        if found is null {
            null
        } else {
            $std::data::Option::some(
                _Chain::get(
                    BTree::node(self, found::node)::values,
                    found::index
                )
            )
        }
    },
    contains: fn(self, key?) {
        BTree::locate(self, key) is not null
    },
    size: fn(self) {
        self::count
    },
    is_empty: fn(self) {
        self::count == 0
    },
    split_child: fn(self, parent_index, index: Number) {
        let parent = BTree::node(self, parent_index);
        let left_index = _Chain::get(parent::children, index);
        let left = BTree::node(self, left_index);
        let right_index = BTree::new_page(self, left::leaf);
        let right = BTree::node(self, right_index);
        let degree = self::degree;
        let pivot_key? = _Chain::get(left::keys, degree - 1);
        let pivot_value? = _Chain::get(left::values, degree - 1);
        for i in $std::ranges::sequence(degree, 2 * degree - 1, 1) {
            _Chain::push(right::keys, _Chain::get(left::keys, i));
            _Chain::push(right::values, _Chain::get(left::values, i));
        };
        if not left::leaf {
            for i in $std::ranges::sequence(degree, 2 * degree, 1) {
                _Chain::push(right::children, _Chain::get(left::children, i));
            };
            for i in $std::ranges::sequence(0, degree, 1) {
                _Chain::pop(left::children);
            };
        };
        for i in $std::ranges::sequence(0, degree, 1) {
            _Chain::pop(left::keys);
            _Chain::pop(left::values);
        };
        _Chain::insert(parent::keys, index, pivot_key);
        _Chain::insert(parent::values, index, pivot_value);
        _Chain::insert(parent::children, index + 1, right_index);
    },
    insert_nonfull: fn(self, current, key?, value?) {
        let node = BTree::node(self, current);
        let index = BTree::lower(self, node, key);
        if node::leaf {
            _Chain::insert(node::keys, index, key);
            _Chain::insert(node::values, index, value);
        } else {
            let child = _Chain::get(node::children, index);
            if _Chain::size(BTree::node(self, child)::keys) == 2 * self::degree
                - 1 {
                BTree::split_child(self, current, index);
                if self::order::less(_Chain::get(node::keys, index), key) {
                    index = index + 1;
                };
            };
            BTree::insert_nonfull(
                self,
                _Chain::get(node::children, index),
                key,
                value
            );
        };
    },
    insert: fn(self, key?, value?) {
        let found? = BTree::locate(self, key);
        if found is not null {
            _Chain::set(
                BTree::node(self, found::node)::values,
                found::index,
                value
            );
            return false;
        };
        if _Chain::size(BTree::node(self, self::root)::keys) == 2 * self::degree
            - 1 {
            let previous = self::root;
            self::root = BTree::new_page(self, false);
            _Chain::push(BTree::node(self, self::root)::children, previous);
            BTree::split_child(self, self::root, 0);
        };
        BTree::insert_nonfull(self, self::root, key, value);
        self::count = self::count + 1;
        true
    },
    extreme: fn(self, current, last: Bool) {
        let index = current;
        loop {
            let node = BTree::node(self, index);
            if node::leaf {
                let item = if last {
                    _Chain::size(node::keys) - 1
                } else {
                    0
                };
                return scope {
                    key?: _Chain::get(node::keys, item),
                    value?: _Chain::get(node::values, item),
                };
            };
            let child = if last {
                _Chain::size(node::children) - 1
            } else {
                0
            };
            index = _Chain::get(node::children, child);
        }
    },
    merge: fn(self, parent_index, index: Number) {
        let parent = BTree::node(self, parent_index);
        let left_index = _Chain::get(parent::children, index);
        let right_index = _Chain::get(parent::children, index + 1);
        let left = BTree::node(self, left_index);
        let right = BTree::node(self, right_index);
        _Chain::push(left::keys, _Chain::remove(parent::keys, index));
        _Chain::push(left::values, _Chain::remove(parent::values, index));
        for i in $std::ranges::sequence(0, _Chain::size(right::keys), 1) {
            _Chain::push(left::keys, _Chain::get(right::keys, i));
            _Chain::push(left::values, _Chain::get(right::values, i));
        };
        for i in $std::ranges::sequence(0, _Chain::size(right::children), 1) {
            _Chain::push(left::children, _Chain::get(right::children, i));
        };
        _Chain::remove(parent::children, index + 1);
        BTree::retire(self, right_index);
        left_index
    },
    borrow_left: fn(self, parent_index, index: Number) {
        let parent = BTree::node(self, parent_index);
        let child = BTree::node(self, _Chain::get(parent::children, index));
        let sibling = BTree::node(
            self,
            _Chain::get(parent::children, index - 1)
        );
        _Chain::insert(child::keys, 0, _Chain::get(parent::keys, index - 1));
        _Chain::insert(
            child::values,
            0,
            _Chain::get(parent::values, index - 1)
        );
        _Chain::set(parent::keys, index - 1, _Chain::pop(sibling::keys));
        _Chain::set(parent::values, index - 1, _Chain::pop(sibling::values));
        if not child::leaf {
            _Chain::insert(child::children, 0, _Chain::pop(sibling::children));
        };
    },
    borrow_right: fn(self, parent_index, index: Number) {
        let parent = BTree::node(self, parent_index);
        let child = BTree::node(self, _Chain::get(parent::children, index));
        let sibling = BTree::node(
            self,
            _Chain::get(parent::children, index + 1)
        );
        _Chain::push(child::keys, _Chain::get(parent::keys, index));
        _Chain::push(child::values, _Chain::get(parent::values, index));
        _Chain::set(parent::keys, index, _Chain::remove(sibling::keys, 0));
        _Chain::set(parent::values, index, _Chain::remove(sibling::values, 0));
        if not child::leaf {
            _Chain::push(child::children, _Chain::remove(sibling::children, 0));
        };
    },
    delete_node: fn(self, current, key?) -> Bool {
        let node = BTree::node(self, current);
        let index = BTree::lower(self, node, key);
        let length = _Chain::size(node::keys);
        if index < length {
            if BTree::equal(self, _Chain::get(node::keys, index), key) {
                if node::leaf {
                    _Chain::remove(node::keys, index);
                    _Chain::remove(node::values, index);
                    return true;
                };
                let left_index = _Chain::get(node::children, index);
                let right_index = _Chain::get(node::children, index + 1);
                if _Chain::size(BTree::node(self, left_index)::keys)
                    >= self::degree {
                    let previous = BTree::extreme(self, left_index, true);
                    _Chain::set(node::keys, index, previous::key);
                    _Chain::set(node::values, index, previous::value);
                    return BTree::delete_node(self, left_index, previous::key);
                };
                if _Chain::size(BTree::node(self, right_index)::keys)
                    >= self::degree {
                    let next = BTree::extreme(self, right_index, false);
                    _Chain::set(node::keys, index, next::key);
                    _Chain::set(node::values, index, next::value);
                    return BTree::delete_node(self, right_index, next::key);
                };
                let merged = BTree::merge(self, current, index);
                return BTree::delete_node(self, merged, key);
            };
        };
        if node::leaf {
            return false;
        };
        let child_index = _Chain::get(node::children, index);
        if _Chain::size(BTree::node(self, child_index)::keys) < self::degree {
            if index > 0 {
                let sibling = BTree::node(
                    self,
                    _Chain::get(node::children, index - 1)
                );
                if _Chain::size(sibling::keys) >= self::degree {
                    BTree::borrow_left(self, current, index);
                    return BTree::delete_node(self, child_index, key);
                };
            };
            if index < length {
                let sibling = BTree::node(
                    self,
                    _Chain::get(node::children, index + 1)
                );
                if _Chain::size(sibling::keys) >= self::degree {
                    BTree::borrow_right(self, current, index);
                    return BTree::delete_node(self, child_index, key);
                };
                child_index = BTree::merge(self, current, index);
            } else {
                child_index = BTree::merge(self, current, index - 1);
            };
        };
        BTree::delete_node(self, child_index, key)
    },
    remove: fn(self, key?) {
        let removed = BTree::delete_node(self, self::root, key);
        let root = BTree::node(self, self::root);
        if not root::leaf and _Chain::size(root::keys) == 0 {
            let previous = self::root;
            self::root = _Chain::get(root::children, 0);
            BTree::retire(self, previous);
        };
        if removed {
            self::count = self::count - 1;
        };
        removed
    },
    visit: fn(self, current, output) {
        let node = BTree::node(self, current);
        let length = _Chain::size(node::keys);
        for index in $std::ranges::sequence(0, length, 1) {
            if not node::leaf {
                BTree::visit(self, _Chain::get(node::children, index), output);
            };
            _Chain::push(
                output,
                scope {
                    key?: _Chain::get(node::keys, index),
                    value?: _Chain::get(node::values, index),
                }
            );
        };
        if not node::leaf {
            BTree::visit(self, _Chain::get(node::children, length), output);
        };
    },
    cursor: fn(self) {
        $std::ranges::Cursor::begin(BTree::entries(self))
    },
    entries: fn(self) {
        let output = _Chain::empty(
            decltype(
                $std::ranges::front(
                    entry_seed(self::key_seed, self::value_seed)
                )
            )
        );
        BTree::visit(self, self::root, output);
        _Chain::take(output)
    },
    visit_range: fn(self, current, low?, high?, output) {
        let node = BTree::node(self, current);
        let first = BTree::lower(self, node, low);
        let length = _Chain::size(node::keys);
        if not node::leaf {
            BTree::visit_range(
                self,
                _Chain::get(node::children, first),
                low,
                high,
                output
            );
        };
        for index in $std::ranges::sequence(first, length, 1) {
            let key? = _Chain::get(node::keys, index);
            if not self::order::less(key, high) {
                return;
            };
            _Chain::push(
                output,
                scope {
                    key?: key,
                    value?: _Chain::get(node::values, index),
                }
            );
            if not node::leaf {
                BTree::visit_range(
                    self,
                    _Chain::get(node::children, index + 1),
                    low,
                    high,
                    output
                );
            };
        };
    },
    range: fn(self, low?, high?) {
        let output = _Chain::empty(
            decltype(
                $std::ranges::front(
                    entry_seed(self::key_seed, self::value_seed)
                )
            )
        );
        if self::order::less(low, high) {
            BTree::visit_range(self, self::root, low, high, output);
        };
        _Chain::take(output)
    },
    validate_walk: fn(self, current, root: Bool, depth: Number, state) -> Null {
        let node = BTree::node(self, current);
        let length = _Chain::size(node::keys);
        state::nodes = state::nodes + 1;
        if length > 2 * self::degree - 1
            or (not root
            and length < self::degree - 1)
            or _Chain::size(node::values) != length {
            state::valid = false;
            return;
        };
        if node::leaf {
            if _Chain::size(node::children) != 0 {
                state::valid = false;
                return;
            };
            if state::depth < 0 {
                state::depth = depth;
            } else {
                if state::depth != depth {
                    state::valid = false;
                };
            };
        } else {
            if length == 0 or _Chain::size(node::children) != length + 1 {
                state::valid = false;
                return;
            };
        };
        for index in $std::ranges::sequence(0, length, 1) {
            if not node::leaf {
                BTree::validate_walk(
                    self,
                    _Chain::get(node::children, index),
                    false,
                    depth + 1,
                    state
                );
            };
            let key? = _Chain::get(node::keys, index);
            if state::count == 0 {
                _Chain::push(state::previous, key);
            } else {
                if not self::order::less(_Chain::get(state::previous, 0), key) {
                    state::valid = false;
                };
                _Chain::set(state::previous, 0, key);
            };
            state::count = state::count + 1;
        };
        if not node::leaf {
            BTree::validate_walk(
                self,
                _Chain::get(node::children, length),
                false,
                depth + 1,
                state
            );
        };
    },
    validate: fn(self) {
        let state = scope {
            valid: true,
            count: 0,
            depth: -1,
            nodes: 0,
            previous: _Chain::empty(
                decltype($std::ranges::front(self::key_seed))
            ),
        };
        BTree::validate_walk(self, self::root, true, 0, state);
        state::valid
            and state::count == self::count
            and state::nodes == self::pages
    },
    height: fn(self) {
        let current = self::root;
        let depth = 1;
        loop {
            let node = BTree::node(self, current);
            if node::leaf {
                return depth;
            };
            current = _Chain::get(node::children, 0);
            depth = depth + 1;
        }
    },
    page_count: fn(self) {
        self::pages
    },
    clear: fn(self) {
        let root = BTree::node(self, self::root);
        _Chain::clear(root::keys);
        _Chain::clear(root::values);
        _Chain::clear(root::children);
        root::leaf = true;
        self::root = root;
        self::pages = 1;
        self::count = 0;
    },
};

# Internal pages contain separator keys only; values stay in linked leaf pages.
scope BPlusTree {
    new: fn(key_prototype?, value_prototype?) {
        BPlusTree::with_policy(
            key_prototype,
            value_prototype,
            scope {
                Self: decltype(key_prototype),
                sample?: key_prototype,
                less: NaturalOrder::less,
            }
        )
    },
    with_policy: fn(
        key_prototype?,
        value_prototype?,
        order: $std::concepts::StrictOrder
    ) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(decltype(key_prototype)),
            $std::ranges::empty_of(decltype(value_prototype)),
            order,
            key_prototype,
            value_prototype
        )
    },
    of_types: fn(key: Type, value: Type) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            scope {
                Self: key,
                sample?: null,
                less: NaturalOrder::less
            },
            null,
            null
        )
    },
    of_types_with: fn(
        key: Type,
        value: Type,
        order: $std::concepts::StrictOrder
    ) {
        BPlusTree::from_seeds(
            $std::ranges::empty_of(key),
            $std::ranges::empty_of(value),
            order,
            null,
            null
        )
    },
    from_seeds: fn(
        keys: Range,
        values: Range,
        order: $std::concepts::StrictOrder,
        key_prototype?,
        value_prototype?
    ) {
        let key_seed = $std::ranges::take(keys, 0);
        let value_seed = $std::ranges::take(values, 0);
        let first = BPlusTree::page(key_seed, value_seed, true);
        let root = first;
        scope {
            pages: 1,
            root: root,
            count: 0,
            degree: 8,
            order: order,
            key_seed: key_seed,
            value_seed: value_seed,
            key_prototype?: key_prototype,
            value_prototype?: value_prototype,
        }
    },
    page: fn(key_seed: Range, value_seed: Range, leaf: Bool) {
        let link?: Scope = null;
        scope {
            leaf: leaf,
            keys: _Chain::empty(decltype($std::ranges::front(key_seed))),
            values: _Chain::empty(decltype($std::ranges::front(value_seed))),
            children: _Chain::empty(Scope),
            next?: link,
        }
    },
    node: fn(self, node) {
        let Page = decltype(BPlusTree::page(self::key_seed, self::value_seed, false));
        node as Page
    },
    new_page: fn(self, leaf: Bool) {
        self::pages = self::pages + 1;
        BPlusTree::page(self::key_seed, self::value_seed, leaf)
    },
    retire: fn(self, node) {
        self::pages = self::pages - 1;
    },
    equal: fn(self, left?, right?) {
        not self::order::less(left, right) and not self::order::less(
            right,
            left
        )
    },
    lower: fn(self, node, key?) {
        let node = BPlusTree::node(self, node);
        let low = 0;
        let high = _Chain::size(node::keys);
        loop {
            if low >= high {
                break;
            };
            let middle = $std::math::floor((low + high) / 2);
            if self::order::less(_Chain::get(node::keys, middle), key) {
                low = middle + 1;
            } else {
                high = middle;
            };
        };
        low
    },
    child_position: fn(self, node, key?) {
        let node = BPlusTree::node(self, node);
        let index = BPlusTree::lower(self, node, key);
        if index < _Chain::size(node::keys) {
            if BPlusTree::equal(self, _Chain::get(node::keys, index), key) {
                index = index + 1;
            };
        };
        index
    },
    descend: fn(self, key?, path) {
        let current = self::root;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return current;
            };
            let index = BPlusTree::child_position(self, node, key);
            _Chain::push(
                path,
                scope {
                    node: current,
                    index: index
                }
            );
            current = _Chain::get(node::children, index);
        }
    },
    leaf: fn(self, key?) {
        let path = _Chain::empty(
            decltype(
                scope {
                    node: self::root,
                    index: 0
                }
            )
        );
        BPlusTree::descend(self, key, path)
    },
    get: fn(self, key?) {
        let node = BPlusTree::node(self, BPlusTree::leaf(self, key));
        let index = BPlusTree::lower(self, node, key);
        if index < _Chain::size(node::keys) {
            if BPlusTree::equal(self, _Chain::get(node::keys, index), key) {
                return $std::data::Option::some(
                    _Chain::get(node::values, index)
                );
            };
        };
        null
    },
    contains: fn(self, key?) {
        BPlusTree::get(self, key) is not null
    },
    size: fn(self) {
        self::count
    },
    is_empty: fn(self) {
        self::count == 0
    },
    split: fn(self, current) {
        let left = BPlusTree::node(self, current);
        let right_index = BPlusTree::new_page(self, left::leaf);
        let right = BPlusTree::node(self, right_index);
        let middle = self::degree;
        let length = _Chain::size(left::keys);
        let separator? = _Chain::get(left::keys, middle);
        let first = if left::leaf {
            middle
        } else {
            middle + 1
        };
        for index in $std::ranges::sequence(first, length, 1) {
            _Chain::push(right::keys, _Chain::get(left::keys, index));
            if left::leaf {
                _Chain::push(right::values, _Chain::get(left::values, index));
            };
        };
        if left::leaf {
            right::next = left::next;
            left::next = right_index;
            for index in $std::ranges::sequence(middle, length, 1) {
                _Chain::pop(left::values);
            };
        } else {
            let children = _Chain::size(left::children);
            for index in $std::ranges::sequence(middle + 1, children, 1) {
                _Chain::push(
                    right::children,
                    _Chain::get(left::children, index)
                );
            };
            for index in $std::ranges::sequence(middle + 1, children, 1) {
                _Chain::pop(left::children);
            };
        };
        for index in $std::ranges::sequence(middle, length, 1) {
            _Chain::pop(left::keys);
        };
        scope {
            key?: separator,
            right: right_index
        }
    },
    insert: fn(self, key?, value?) {
        let path = _Chain::empty(
            decltype(
                scope {
                    node: self::root,
                    index: 0
                }
            )
        );
        let current = BPlusTree::descend(self, key, path);
        let node = BPlusTree::node(self, current);
        let index = BPlusTree::lower(self, node, key);
        if index < _Chain::size(node::keys) {
            if BPlusTree::equal(self, _Chain::get(node::keys, index), key) {
                _Chain::set(node::values, index, value);
                return false;
            };
        };
        _Chain::insert(node::keys, index, key);
        _Chain::insert(node::values, index, value);
        self::count = self::count + 1;
        loop {
            let page = BPlusTree::node(self, current);
            if _Chain::size(page::keys) <= 2 * self::degree - 1 {
                break;
            };
            let split = BPlusTree::split(self, current);
            if _Chain::size(path) == 0 {
                let root = BPlusTree::new_page(self, false);
                let parent = BPlusTree::node(self, root);
                _Chain::push(parent::keys, split::key);
                _Chain::push(parent::children, current);
                _Chain::push(parent::children, split::right);
                self::root = root;
                break;
            };
            let entry = _Chain::pop(path);
            let parent = BPlusTree::node(self, entry::node);
            _Chain::insert(parent::keys, entry::index, split::key);
            _Chain::insert(parent::children, entry::index + 1, split::right);
            current = entry::node;
        };
        true
    },
    refresh_minimum: fn(self, path, minimum?) {
        loop {
            if _Chain::size(path) == 0 {
                break;
            };
            let entry = _Chain::pop(path);
            if entry::index > 0 {
                _Chain::set(
                    BPlusTree::node(self, entry::node)::keys,
                    entry::index - 1,
                    minimum
                );
                break;
            };
        };
    },
    borrow_left: fn(self, parent, index: Number, child, sibling) {
        if child::leaf {
            _Chain::insert(child::keys, 0, _Chain::pop(sibling::keys));
            _Chain::insert(child::values, 0, _Chain::pop(sibling::values));
            _Chain::set(parent::keys, index - 1, _Chain::get(child::keys, 0));
        } else {
            _Chain::insert(
                child::keys,
                0,
                _Chain::get(parent::keys, index - 1)
            );
            _Chain::insert(child::children, 0, _Chain::pop(sibling::children));
            _Chain::set(parent::keys, index - 1, _Chain::pop(sibling::keys));
        };
    },
    borrow_right: fn(self, parent, index: Number, child, sibling) {
        if child::leaf {
            _Chain::push(child::keys, _Chain::remove(sibling::keys, 0));
            _Chain::push(child::values, _Chain::remove(sibling::values, 0));
            _Chain::set(parent::keys, index, _Chain::get(sibling::keys, 0));
        } else {
            _Chain::push(child::keys, _Chain::get(parent::keys, index));
            _Chain::push(child::children, _Chain::remove(sibling::children, 0));
            _Chain::set(parent::keys, index, _Chain::remove(sibling::keys, 0));
        };
    },
    merge: fn(self, parent, index: Number) {
        let left_index = _Chain::get(parent::children, index);
        let right_index = _Chain::get(parent::children, index + 1);
        let left = BPlusTree::node(self, left_index);
        let right = BPlusTree::node(self, right_index);
        if left::leaf {
            left::next = right::next;
        } else {
            _Chain::push(left::keys, _Chain::get(parent::keys, index));
        };
        let keys = right::keys;
        for item in $std::ranges::sequence(0, _Chain::size(keys), 1) {
            _Chain::push(left::keys, _Chain::get(keys, item));
        };
        let values = right::values;
        for item in $std::ranges::sequence(0, _Chain::size(values), 1) {
            _Chain::push(left::values, _Chain::get(values, item));
        };
        let children = right::children;
        for item in $std::ranges::sequence(0, _Chain::size(children), 1) {
            _Chain::push(left::children, _Chain::get(children, item));
        };
        _Chain::remove(parent::keys, index);
        _Chain::remove(parent::children, index + 1);
        BPlusTree::retire(self, right_index);
        left_index
    },
    remove: fn(self, key?) {
        let path = _Chain::empty(
            decltype(
                scope {
                    node: self::root,
                    index: 0
                }
            )
        );
        let current = BPlusTree::descend(self, key, path);
        let leaf = BPlusTree::node(self, current);
        let index = BPlusTree::lower(self, leaf, key);
        if index == _Chain::size(leaf::keys) {
            return false;
        };
        if not BPlusTree::equal(self, _Chain::get(leaf::keys, index), key) {
            return false;
        };
        _Chain::remove(leaf::keys, index);
        _Chain::remove(leaf::values, index);
        self::count = self::count - 1;
        if _Chain::size(path) == 0 {
            return true;
        };
        let changed = index == 0;
        let minimum? = _Chain::get(leaf::keys, 0);
        loop {
            if _Chain::size(path) == 0 {
                break;
            };
            let entry = _Chain::pop(path);
            let parent = BPlusTree::node(self, entry::node);
            let child = BPlusTree::node(self, current);
            if changed and entry::index > 0 {
                _Chain::set(parent::keys, entry::index - 1, minimum);
                changed = false;
            };
            if _Chain::size(child::keys) >= self::degree - 1 {
                if changed {
                    BPlusTree::refresh_minimum(self, path, minimum);
                };
                break;
            };
            if entry::index > 0 {
                let sibling = BPlusTree::node(
                    self,
                    _Chain::get(parent::children, entry::index - 1)
                );
                if _Chain::size(sibling::keys) >= self::degree {
                    BPlusTree::borrow_left(
                        self,
                        parent,
                        entry::index,
                        child,
                        sibling
                    );
                    break;
                };
            };
            if entry::index < _Chain::size(parent::keys) {
                let sibling = BPlusTree::node(
                    self,
                    _Chain::get(parent::children, entry::index + 1)
                );
                if _Chain::size(sibling::keys) >= self::degree {
                    BPlusTree::borrow_right(
                        self,
                        parent,
                        entry::index,
                        child,
                        sibling
                    );
                    if changed {
                        BPlusTree::refresh_minimum(self, path, minimum);
                    };
                    break;
                };
                BPlusTree::merge(self, parent, entry::index);
            } else {
                BPlusTree::merge(self, parent, entry::index - 1);
            };
            current = entry::node;
        };
        let root = BPlusTree::node(self, self::root);
        if not root::leaf and _Chain::size(root::keys) == 0 {
            let previous = self::root;
            self::root = _Chain::get(root::children, 0);
            BPlusTree::retire(self, previous);
        };
        true
    },
    first_leaf: fn(self) {
        let current = self::root;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return current;
            };
            current = _Chain::get(node::children, 0);
        }
    },
    collect: fn(self, current, first: Number, output) {
        let page = current;
        let start = first;
        loop {
            let node = BPlusTree::node(self, page);
            for index in $std::ranges::sequence(
                start,
                _Chain::size(node::keys),
                1
            ) {
                _Chain::push(
                    output,
                    scope {
                        key?: _Chain::get(node::keys, index),
                        value?: _Chain::get(node::values, index),
                    }
                );
            };
            let next? = node::next;
            if next is null {
                break;
            };
            page = next;
            start = 0;
        };
    },
    cursor: fn(self) {
        $std::ranges::Cursor::begin(BPlusTree::entries(self))
    },
    entries: fn(self) {
        let output = _Chain::empty(
            decltype(
                $std::ranges::front(
                    entry_seed(self::key_seed, self::value_seed)
                )
            )
        );
        BPlusTree::collect(self, BPlusTree::first_leaf(self), 0, output);
        _Chain::take(output)
    },
    range: fn(self, low?, high?) {
        let output = _Chain::empty(
            decltype(
                $std::ranges::front(
                    entry_seed(self::key_seed, self::value_seed)
                )
            )
        );
        if self::order::less(low, high) {
            let page = BPlusTree::leaf(self, low);
            let start = BPlusTree::lower(
                self,
                BPlusTree::node(self, page),
                low
            );
            loop {
                let node = BPlusTree::node(self, page);
                for index in $std::ranges::sequence(
                    start,
                    _Chain::size(node::keys),
                    1
                ) {
                    let key? = _Chain::get(node::keys, index);
                    if not self::order::less(key, high) {
                        return _Chain::take(output);
                    };
                    _Chain::push(
                        output,
                        scope {
                            key?: key,
                            value?: _Chain::get(node::values, index),
                        }
                    );
                };
                let next? = node::next;
                if next is null {
                    break;
                };
                page = next;
                start = 0;
            };
        };
        _Chain::take(output)
    },
    minimum: fn(self, current) {
        let page = current;
        loop {
            let node = BPlusTree::node(self, page);
            if node::leaf {
                return _Chain::get(node::keys, 0);
            };
            page = _Chain::get(node::children, 0);
        }
    },
    validate_walk: fn(self, current, root: Bool, depth: Number, state) -> Null {
        let node = BPlusTree::node(self, current);
        let length = _Chain::size(node::keys);
        state::nodes = state::nodes + 1;
        if length > 2 * self::degree - 1
            or (not root
            and length < self::degree - 1) {
            state::valid = false;
            return;
        };
        if node::leaf {
            if _Chain::size(node::children) != 0
                or _Chain::size(node::values) != length {
                state::valid = false;
                return;
            };
            if state::depth < 0 {
                state::depth = depth;
            } else {
                if state::depth != depth {
                    state::valid = false;
                };
            };
            if state::previous_leaf is not null {
                if not _same_scope(
                    BPlusTree::node(self, state::previous_leaf)::next,
                    current
                ) {
                    state::valid = false;
                };
            };
            state::previous_leaf = current;
            let previous = state::previous;
            for index in $std::ranges::sequence(0, length, 1) {
                let key? = _Chain::get(node::keys, index);
                if state::count == 0 {
                    _Chain::push(previous, key);
                } else {
                    if not self::order::less(_Chain::get(previous, 0), key) {
                        state::valid = false;
                    };
                    _Chain::set(previous, 0, key);
                };
                state::count = state::count + 1;
            };
        } else {
            if length == 0
                or _Chain::size(node::values) != 0
                or _Chain::size(node::children) != length + 1 {
                state::valid = false;
                return;
            };
            for index in $std::ranges::sequence(0, length + 1, 1) {
                let child = _Chain::get(node::children, index);
                BPlusTree::validate_walk(self, child, false, depth + 1, state);
                if index > 0 {
                    if not BPlusTree::equal(
                        self,
                        _Chain::get(node::keys, index - 1),
                        BPlusTree::minimum(self, child)
                    ) {
                        state::valid = false;
                    };
                };
            };
        };
    },
    validate: fn(self) {
        let link?: Scope = null;
        let state = scope {
            valid: true,
            count: 0,
            depth: -1,
            nodes: 0,
            previous: _Chain::empty(
                decltype($std::ranges::front(self::key_seed))
            ),
            previous_leaf?: link,
        };
        BPlusTree::validate_walk(self, self::root, true, 0, state);
        state::valid
            and state::count == self::count
            and state::previous_leaf is not null
            and BPlusTree::node(self, state::previous_leaf)::next is null
            and state::nodes == self::pages
    },
    height: fn(self) {
        let current = self::root;
        let depth = 1;
        loop {
            let node = BPlusTree::node(self, current);
            if node::leaf {
                return depth;
            };
            current = _Chain::get(node::children, 0);
            depth = depth + 1;
        }
    },
    page_count: fn(self) {
        self::pages
    },
    clear: fn(self) {
        let root = BPlusTree::node(self, self::root);
        _Chain::clear(root::keys);
        _Chain::clear(root::values);
        _Chain::clear(root::children);
        root::leaf = true;
        root::next = null;
        self::root = root;
        self::pages = 1;
        self::count = 0;
    },
};

fn _set_ref(tree, node) {
    let Node = decltype(tree::nil);
    node as Node
};

fn _set_child(tree, node, left: Bool) {
    let Node = decltype(tree::nil);
    let current = node as Node;
    let child? = if left { current::left } else { current::right };
    if child is null { current } else { child as Node }
};

fn _set_parent(tree, node) {
    let Node = decltype(tree::nil);
    let current = node as Node;
    let parent? = current::parent;
    if parent is null { current } else { parent as Node }
};

fn _set_key(self, node) {
    let Item = decltype($std::ranges::front(self::seed));
    let key? = node::key;
    if key is null {
        if $std::meta::accepts(Item, Null) { null }
        else { $std::ranges::front(self::seed) }
    } else { key as Item }
};

fn _set_link(tree, node, left: Bool, child) {
    let node = _set_ref(tree, node);
    let child = _set_ref(tree, child);
    if left {
        node::left = child;
    } else {
        node::right = child;
    };
    if not child::nil {
        child::on_left = left;
    };
};

# Links below are ordinary Scope references; tree nodes are logical allocations.
fn _set_find(self, key?) {
    let tree = self;
    let index = _set_ref(tree, tree::root);
    loop {
        if index::nil {
            return tree::nil;
        };
        let value? = _set_key(self, index);
        if self::order::less(key, value) {
            index = _set_child(tree, index, true);
        } else {
            if self::order::less(value, key) {
                index = _set_child(tree, index, false);
            } else {
                return index;
            };
        };
    }
};

# Mirroring the direction keeps insertion and removal repair identical.
fn _set_rotate(tree, index, left: Bool) {
    let child = _set_child(tree, index, not left);
    let middle = _set_child(tree, child, left);
    let parent = _set_parent(tree, index);
    _set_link(tree, index, not left, middle);
    if not middle::nil {
        middle::parent = index;
    };
    child::parent = parent;
    child::on_left = index::on_left;
    if parent::nil {
        tree::root = child;
    } else {
        let on_left = index::on_left;
        _set_link(tree, parent, on_left, child);
    };
    _set_link(tree, child, left, index);
    index::parent = child;
};

fn _set_repair_insert(tree, inserted) {
    let index = inserted;
    loop {
        let parent = _set_parent(tree, index);
        if not parent::red {
            break;
        };
        let grand = _set_parent(tree, parent);
        let on_left = parent::on_left;
        let uncle = _set_child(tree, grand, not on_left);
        if uncle::red {
            parent::red = false;
            uncle::red = false;
            grand::red = true;
            index = grand;
        } else {
            if index::on_left != on_left {
                index = parent;
                _set_rotate(tree, index, on_left);
            };
            let next_parent = _set_parent(tree, index);
            let next_grand = _set_parent(tree, next_parent);
            next_parent::red = false;
            next_grand::red = true;
            _set_rotate(tree, next_grand, not on_left);
        };
    };
    tree::root::red = false;
};

fn _set_edge(tree, start, left: Bool) {
    let index = _set_ref(tree, start);
    loop {
        let child = _set_child(tree, index, left);
        if child::nil {
            return index;
        };
        index = child;
    }
};

fn _set_next(tree, start) {
    let right = _set_child(tree, start, false);
    if not right::nil {
        return _set_edge(tree, right, true);
    };
    let index = _set_ref(tree, start);
    let parent = _set_parent(tree, start);
    loop {
        if parent::nil {
            return tree::nil;
        };
        if index::on_left {
            return parent;
        };
        index = parent;
        parent = _set_parent(tree, index);
    }
};

fn _set_transplant(tree, removed, replacement) {
    let parent = _set_parent(tree, removed);
    if parent::nil {
        tree::root = replacement;
    } else {
        let on_left = removed::on_left;
        _set_link(tree, parent, on_left, replacement);
    };
    replacement::parent = parent;
    replacement::on_left = removed::on_left;
};

fn _set_repair_remove(tree, removed) {
    let index = removed;
    loop {
        if _set_parent(tree, index)::nil or index::red {
            break;
        };
        let parent = _set_parent(tree, index);
        let on_left = index::on_left;
        let sibling = _set_child(tree, parent, not on_left);
        if sibling::red {
            sibling::red = false;
            parent::red = true;
            _set_rotate(tree, parent, on_left);
            sibling = _set_child(tree, parent, not on_left);
        };
        let near = _set_child(tree, sibling, on_left);
        let far = _set_child(tree, sibling, not on_left);
        if not near::red and not far::red {
            sibling::red = true;
            index = parent;
        } else {
            if not far::red {
                near::red = false;
                sibling::red = true;
                _set_rotate(tree, sibling, not on_left);
            };
            let next_sibling = _set_child(tree, parent, not on_left);
            next_sibling::red = parent::red;
            parent::red = false;
            let next_far = _set_child(tree, next_sibling, not on_left);
            next_far::red = false;
            _set_rotate(tree, parent, on_left);
            index = tree::root;
        };
    };
    index::red = false;
};

fn _set_bound(self, key?) {
    let tree = self;
    let index = _set_ref(tree, tree::root);
    let candidate = tree::nil;
    loop {
        if index::nil {
            return candidate;
        };
        if self::order::less(_set_key(self, index), key) {
            index = _set_child(tree, index, false);
        } else {
            candidate = index;
            index = _set_child(tree, index, true);
        };
    }
};

# Ordered Set with logarithmic point operations and an explicit comparison policy.
# Comparator-equivalent keys are unique; snapshots retain membership, not deep copies.
scope Set {
    new: fn(initial: Range | Type) {
        Set::with_policy(
            initial,
            scope {
                Self: decltype(
                    $std::ranges::front(construction_range(initial))
                ),
                sample?: null,
                less: NaturalOrder::less,
            }
        )
    },
    empty: fn(prototype?) {
        Set::new($std::ranges::take([prototype], 0))
    },
    with_policy: fn(initial: Range | Type, order: $std::concepts::StrictOrder) {
        let source = construction_range(initial);
        let Item = decltype($std::ranges::front(source));
        let nil_key?: Item = null;
        let link?: Scope = null;
        let nil = scope {
            key?: nil_key,
            left?: link,
            right?: link,
            parent?: link,
            red: false,
            nil: true,
            on_left: false
        };
        nil::left = nil;
        nil::right = nil;
        nil::parent = nil;
        let self = scope {
            root: nil,
            nil: nil,
            count: 0,
            order: order,
            seed: $std::ranges::take(source, 0)
        };
        if not(decltype(initial) is Type) {
            for value? in $std::ranges::materialize(source) {
                Set::insert(self, value);
            };
        };
        self
    },
    size: fn(self) -> Number {
        self::count
    },
    is_empty: fn(self) -> Bool {
        Set::size(self) == 0
    },
    contains: fn(self, key?) -> Bool {
        not _set_find(self, key)::nil
    },
    insert: fn(self, key?) -> Bool {
        let Item = decltype($std::ranges::front(self::seed));
        let typed: Item = key;
        let tree = self;
        let parent = tree::nil;
        let index = _set_ref(tree, tree::root);
        let direction = false;
        loop {
            if index::nil {
                break;
            };
            parent = index;
            let value? = _set_key(self, index);
            if self::order::less(key, value) {
                direction = true;
            } else {
                if not self::order::less(value, key) {
                    return false;
                };
                direction = false;
            };
            index = _set_child(tree, index, direction);
        };
        let inserted = scope {
            key?: typed,
            left?: tree::nil,
            right?: tree::nil,
            parent?: parent,
            red: true,
            nil: false,
            on_left: direction
        };
        tree::count = tree::count + 1;
        if parent::nil {
            tree::root = inserted;
        } else {
            _set_link(tree, parent, direction, inserted);
        };
        _set_repair_insert(tree, inserted);
        true
    },
    remove: fn(self, key?) -> Bool {
        let tree = self;
        let removed = _set_find(self, key);
        if removed::nil {
            return false;
        };
        let left = _set_child(tree, removed, true);
        let right = _set_child(tree, removed, false);
        let was_red = removed::red;
        let replacement = tree::nil;
        if left::nil {
            replacement = right;
            _set_transplant(tree, removed, right);
        } else {
            if right::nil {
                replacement = left;
                _set_transplant(tree, removed, left);
            } else {
                let successor = _set_edge(tree, right, true);
                was_red = successor::red;
                replacement = _set_child(tree, successor, false);
                if _set_child(tree, right, true)::nil {
                    replacement::parent = successor;
                    replacement::on_left = false;
                } else {
                    _set_transplant(tree, successor, replacement);
                    _set_link(tree, successor, false, right);
                    right::parent = successor;
                };
                _set_transplant(tree, removed, successor);
                _set_link(tree, successor, true, left);
                left::parent = successor;
                successor::red = removed::red;
            };
        };
        if not was_red {
            _set_repair_remove(tree, replacement);
        };
        tree::count = tree::count - 1;
        true
    },
    lower_bound: fn(self, key?) -> $std::concepts::Option? {
        let tree = self;
        let index = _set_bound(self, key);
        if index::nil {
            null
        } else {
            $std::data::Option::some(_set_key(self, index))
        }
    },
    get: fn(self, key?) -> $std::concepts::Option? {
        let tree = self;
        let index = _set_find(self, key);
        if index::nil {
            null
        } else {
            $std::data::Option::some(_set_key(self, index))
        }
    },
    first: fn(self) -> $std::concepts::Option? {
        let tree = self;
        let root = tree::root;
        if root::nil {
            null
        } else {
            $std::data::Option::some(_set_key(self, _set_edge(tree, root, true)))
        }
    },
    last: fn(self) -> $std::concepts::Option? {
        let tree = self;
        let root = tree::root;
        if root::nil {
            null
        } else {
            $std::data::Option::some(_set_key(self, _set_edge(tree, root, false)))
        }
    },
    pop_first: fn(self) -> $std::concepts::Option? {
        let tree = self;
        let root = tree::root;
        if root::nil {
            return null;
        };
        let value? = _set_key(self, _set_edge(tree, root, true));
        Set::remove(self, value);
        $std::data::Option::some(value)
    },
    pop_last: fn(self) -> $std::concepts::Option? {
        let tree = self;
        let root = tree::root;
        if root::nil {
            return null;
        };
        let value? = _set_key(self, _set_edge(tree, root, false));
        Set::remove(self, value);
        $std::data::Option::some(value)
    },
    extend: fn(self, values: Range) -> Number {
        let added = 0;
        for value? in values {
            if Set::insert(self, value) {
                added = added + 1;
            };
        };
        added
    },
    cursor: fn(self) {
        $std::ranges::Cursor::begin(Set::snapshot(self))
    },
    snapshot: fn(self) {
        let tree = self;
        let output = _Chain::empty(decltype($std::ranges::front(self::seed)));
        let index = _set_edge(tree, tree::root, true);
        loop {
            if index::nil {
                break;
            };
            _Chain::push(output, _set_key(self, index));
            index = _set_next(tree, index);
        };
        _Chain::take(output)
    },
    range: fn(self, lower?, upper?) {
        let tree = self;
        let output = _Chain::empty(decltype($std::ranges::front(self::seed)));
        let index = _set_bound(self, lower);
        loop {
            if index::nil {
                break;
            };
            let value? = _set_key(self, index);
            if not self::order::less(value, upper) {
                break;
            };
            _Chain::push(output, value);
            index = _set_next(tree, index);
        };
        _Chain::take(output)
    },
    clear: fn(self) {
        self::root = self::nil;
        self::nil::parent = self::nil;
        self::count = 0;
    },
};

# A complete binary tree retains the array heap's breadth-first positions without
# a native vector carrier. Sifts follow ordinary parent/child references.
fn _heap_ref(self, node) {
    let Node = decltype(self::nil);
    node as Node
};

fn _heap_link(self, node, left: Bool) {
    let Node = decltype(self::nil);
    let current = node as Node;
    let child? = if left { current::left } else { current::right };
    if child is null { current } else { child as Node }
};

fn _heap_parent(self, node) {
    let Node = decltype(self::nil);
    let current = node as Node;
    let parent? = current::parent;
    if parent is null { current } else { parent as Node }
};

fn _heap_value(self, node) {
    let Item = decltype($std::ranges::front(self::seed));
    let Node = decltype(self::nil);
    let current = node as Node;
    let value? = current::value;
    if value is null {
        if $std::meta::accepts(Item, Null) { null }
        else { $std::ranges::front(self::seed) }
    } else { value as Item }
};

fn _heap_node(self, index: Number) {
    if index < 0 or index >= self::count or index != $std::math::trunc(index) {
        $std::ranges::at(self::seed, index);
        return self::nil;
    };
    let position = index + 1;
    let bit = 1;
    loop {
        if bit * 2 > position {
            break;
        };
        bit = bit * 2;
    };
    let node = self::root;
    loop {
        if bit == 1 {
            return _heap_ref(self, node);
        };
        bit = bit / 2;
        if $std::math::floor(position/bit) % 2 == 0 {
            node = _heap_link(self, node, true);
        } else {
            node = _heap_link(self, node, false);
        };
    }
};

fn _heap_sift_up(self, start) {
    let node = _heap_ref(self, start);
    let value? = _heap_value(self, node);
    loop {
        let parent = _heap_parent(self, node);
        if parent::nil {
            break;
        };
        let above? = _heap_value(self, parent);
        if not self::order::less(value, above) {
            break;
        };
        node::value = above;
        node = parent;
    };
    node::value = value;
};

fn _heap_sift_down(self, start) {
    let node = _heap_ref(self, start);
    let value? = _heap_value(self, node);
    loop {
        let child = _heap_link(self, node, true);
        if child::nil {
            break;
        };
        let right = _heap_link(self, node, false);
        if not right::nil {
            if self::order::less(_heap_value(self, right), _heap_value(self, child)) {
                child = right;
            };
        };
        let below? = _heap_value(self, child);
        if not self::order::less(below, value) {
            break;
        };
        node::value = below;
        node = child;
    };
    node::value = value;
};

scope Heap {
    new: fn(initial: Range | Type) {
        Heap::with_policy(
            initial,
            scope {
                Self: decltype(
                    $std::ranges::front(construction_range(initial))
                ),
                sample?: null,
                less: NaturalOrder::less,
            }
        )
    },
    empty: fn(prototype?) {
        Heap::new($std::ranges::take([prototype], 0))
    },
    with_policy: fn(initial: Range | Type, order: $std::concepts::StrictOrder) {
        let source = construction_range(initial);
        let Item = decltype($std::ranges::front(source));
        let nil_value?: Item = null;
        let link?: Scope = null;
        let nil = scope {
            value?: nil_value,
            left?: link,
            right?: link,
            parent?: link,
            nil: true
        };
        nil::left = nil;
        nil::right = nil;
        nil::parent = nil;
        let self = scope {
            root: nil,
            nil: nil,
            count: 0,
            order: order,
            seed: $std::ranges::take(source, 0)
        };
        if not(decltype(initial) is Type) {
            let parents = _Chain::empty(Scope);
            let rows = _Chain::empty(Scope);
            for value? in $std::ranges::materialize(source) {
                let typed: Item = value;
                let node = scope {
                    value?: typed,
                    left?: nil,
                    right?: nil,
                    parent?: nil,
                    nil: false
                };
                if self::count == 0 {
                    self::root = node;
                } else {
                    let parent = _heap_ref(self, _Chain::get(parents, 0));
                    node::parent = parent;
                    if _heap_link(self, parent, true)::nil {
                        parent::left = node;
                    } else {
                        parent::right = node;
                        _Chain::remove(parents, 0);
                    };
                };
                _Chain::push(parents, node);
                _Chain::push(rows, node);
                self::count = self::count + 1;
            };
            loop {
                if _Chain::size(rows) == 0 {
                    break;
                };
                let node = _Chain::pop(rows);
                _heap_sift_down(self, node);
            };
        };
        self
    },
    size: fn(self) {
        self::count
    },
    is_empty: fn(self) {
        self::count == 0
    },
    clear: fn(self) {
        self::root = self::nil;
        self::count = 0;
    },
    peek: fn(self) {
        if self::count == 0 {
            null
        } else {
            _heap_value(self, self::root)
        }
    },
    push: fn(self, value?) {
        let Item = decltype($std::ranges::front(self::seed));
        let typed: Item = value;
        let index = self::count;
        let parent = if index == 0 {
            self::nil
        } else {
            _heap_node(self, $std::math::floor((index - 1) / 2))
        };
        let node = scope {
            value?: typed,
            left?: self::nil,
            right?: self::nil,
            parent?: parent,
            nil: false
        };
        if index == 0 {
            self::root = node;
        } else {
            if index % 2 == 1 {
                parent::left = node;
            } else {
                parent::right = node;
            };
        };
        self::count = index + 1;
        _heap_sift_up(self, node);
    },
    pop: fn(self) {
        if self::count == 0 {
            null
        } else {
            Heap::remove_top(self)
        }
    },
    remove_top: fn(self) {
        let first? = _heap_value(self, self::root);
        let index = self::count - 1;
        let tail = _heap_node(self, index);
        let last? = _heap_value(self, tail);
        let parent = _heap_parent(self, tail);
        if not parent::nil {
            if index % 2 == 1 {
                parent::left = self::nil;
            } else {
                parent::right = self::nil;
            };
        };
        self::count = index;
        if index == 0 {
            self::root = self::nil;
        } else {
            self::root::value = last;
            _heap_sift_down(self, self::root);
        };
        first
    },
    replace_top: fn(self, value?) {
        if self::count == 0 {
            Heap::push(self, value);
            return null;
        };
        let first? = _heap_value(self, self::root);
        self::root::value = value;
        _heap_sift_down(self, self::root);
        first
    },
    push_pop: fn(self, value?) {
        if self::count == 0 {
            return value;
        };
        let first? = _heap_value(self, self::root);
        if self::order::less(first, value) {
            self::root::value = value;
            _heap_sift_down(self, self::root);
            first
        } else {
            value
        }
    },
    extend: fn(self, values: Range) {
        for value? in values {
            Heap::push(self, value);
        };
    },
    cursor: fn(self) {
        $std::ranges::Cursor::begin(Heap::snapshot(self))
    },
    snapshot: fn(self) {
        let output = _Chain::empty(decltype($std::ranges::front(self::seed)));
        let pending = _Chain::empty(Scope);
        if self::count > 0 {
            _Chain::push(pending, self::root);
        };
        loop {
            if _Chain::size(pending) == 0 {
                break;
            };
            let node = _Chain::remove(pending, 0);
            _Chain::push(output, _heap_value(self, node));
            if not _heap_link(self, node, true)::nil {
                _Chain::push(pending, _heap_link(self, node, true));
            };
            if not _heap_link(self, node, false)::nil {
                _Chain::push(pending, _heap_link(self, node, false));
            };
        };
        _Chain::take(output)
    },
    drain: fn(self) {
        let output = _Chain::empty(decltype($std::ranges::front(self::seed)));
        loop {
            if self::count == 0 {
                break;
            };
            _Chain::push(output, Heap::remove_top(self));
        };
        _Chain::take(output)
    },
    sorted: fn(self) {
        Heap::drain(Heap::with_policy(Heap::snapshot(self), self::order))
    },
    validate: fn(self) -> Bool {
        let pending = _Chain::empty(Scope);
        if self::count > 0 {
            _Chain::push(pending, self::root);
        };
        let count = 0;
        let gap = false;
        loop {
            if _Chain::size(pending) == 0 {
                break;
            };
            let node = _Chain::remove(pending, 0);
            count = count + 1;
            if count > self::count {
                return false;
            };
            if _heap_link(self, node, true)::nil {
                gap = true;
            } else {
                if gap or not _same_scope(_heap_link(self, node, true)::parent, node) {
                    return false;
                };
                if self::order::less(_heap_value(self, _heap_link(self, node, true)), _heap_value(self, node)) {
                    return false;
                };
                _Chain::push(pending, _heap_link(self, node, true));
            };
            if _heap_link(self, node, false)::nil {
                gap = true;
            } else {
                if gap or not _same_scope(_heap_link(self, node, false)::parent, node) {
                    return false;
                };
                if self::order::less(_heap_value(self, _heap_link(self, node, false)), _heap_value(self, node)) {
                    return false;
                };
                _Chain::push(pending, _heap_link(self, node, false));
            };
        };
        count == self::count
    },
    sift_up: fn(self, index: Number) {
        _heap_sift_up(self, _heap_node(self, index));
    },
    sift_down: fn(self, index: Number) {
        _heap_sift_down(self, _heap_node(self, index));
    },
};
