# Host filesystem operations preserve endpoint provenance and execute only at runtime.
native fn exists(path: Path | String) -> Bool;
native fn delete(path: Path | String) -> Null;
native fn touch(path: Path | String) -> Null;
native fn status(path: Path | String) -> String;
native fn symlink_status(path: Path | String) -> String;
native fn is_regular_file(path: Path | String) -> Bool;
native fn is_directory(path: Path | String) -> Bool;
native fn is_symlink(path: Path | String) -> Bool;
native fn is_block_file(path: Path | String) -> Bool;
native fn is_character_file(path: Path | String) -> Bool;
native fn is_fifo(path: Path | String) -> Bool;
native fn is_socket(path: Path | String) -> Bool;
native fn is_other(path: Path | String) -> Bool;
native fn is_empty(path: Path | String) -> Bool;
native fn permissions(path: Path | String) -> Range<String>;
native fn set_permissions(path: Path | String, flags: String) -> Null;
native fn is_readonly(path: Path | String) -> Bool;
native fn set_readonly(path: Path | String, readonly: Bool) -> Null;
native fn equivalent(left: Path | String, right: Path | String) -> Bool;
native fn absolute(path: Path | String) -> Path;
native fn canonical(path: Path | String) -> Path;
native fn weakly_canonical(path: Path | String) -> Path;
native fn read_symlink(path: Path | String) -> Path;
native fn temp_directory_path() -> Path;
native fn create_directory(path: Path | String) -> Bool;
native fn create_directories(path: Path | String) -> Bool;
native fn remove(path: Path | String) -> Bool;
native fn remove_all(path: Path | String) -> Bool;
native fn remove_directory(path: Path | String) -> Bool;
native fn rename(source: Path | String, destination: Path | String) -> Null;
native fn create_hard_link(target: Path | String, link: Path | String) -> Null;
native fn create_symlink(target: Path | String, link: Path | String) -> Null;
native fn create_directory_symlink(target: Path | String, link: Path | String) -> Null;
native fn copy_symlink(source: Path | String, destination: Path | String) -> Null;
native fn copy_file(source: Path | String, destination: Path | String) -> Bool;
native fn components(path: Path | String) -> Range<Path>;
native fn directory_iterator(path: Path | String) -> Range<Path>;
native fn recursive_directory_iterator(path: Path | String) -> Range<Path>;
native fn root_name(path: Path | String) -> Path;
native fn root_directory(path: Path | String) -> Path;
native fn root_path(path: Path | String) -> Path;
native fn relative_path(path: Path | String) -> Path;
native fn parent_path(path: Path | String) -> Path;
native fn filename(path: Path | String) -> Path;
native fn stem(path: Path | String) -> Path;
native fn extension(path: Path | String) -> Path;
native fn lexically_normal(path: Path | String) -> Path;
native fn lexically_relative(path: Path | String, base: Path | String) -> Path;
native fn lexically_proximate(path: Path | String, base: Path | String) -> Path;
native fn replace_filename(path: Path | String, name: Path | String) -> Path;
native fn replace_extension(path: Path | String, extension: Path | String) -> Path;
native fn remove_filename(path: Path | String) -> Path;
native fn append(path: Path | String, suffix: Path | String) -> Path;
native fn concat(path: Path | String, suffix: Path | String) -> Path;
native fn make_preferred(path: Path | String) -> Path;
native fn string(path: Path | String) -> String;
native fn generic_string(path: Path | String) -> String;
native fn has_root_name(path: Path | String) -> Bool;
native fn has_root_directory(path: Path | String) -> Bool;
native fn has_root_path(path: Path | String) -> Bool;
native fn has_relative_path(path: Path | String) -> Bool;
native fn has_parent_path(path: Path | String) -> Bool;
native fn has_filename(path: Path | String) -> Bool;
native fn has_stem(path: Path | String) -> Bool;
native fn has_extension(path: Path | String) -> Bool;
native fn is_absolute(path: Path | String) -> Bool;
native fn path_empty(path: Path | String) -> Bool;
native fn is_relative(path: Path | String) -> Bool;

fn current_path() { $pwd @ pwd };
fn relative(path, base) { lexically_relative(weakly_canonical(path), weakly_canonical(base)) };
fn proximate(path, base) { lexically_proximate(weakly_canonical(path), weakly_canonical(base)) };
fn status_known(status: String) { status != "none" };
fn copy(source, destination) { source -> destination };
