# Text is UTF-8. Range readers open on demand and close when enumeration ends.
native fn read_text(path: Path or String) -> String;
native fn read_lines(path: Path or String) -> Range<String>;
native fn read_bytes(path: Path or String) -> Range<Number>;
native fn write_text(path: Path or String, text: String) -> Null;
native fn append_text(path: Path or String, text: String) -> Null;
native fn write_bytes(path: Path or String, bytes: Range<Number>) -> Null;
native fn append_bytes(path: Path or String, bytes: Range<Number>) -> Null;
native fn file_size(path: Path or String) -> Number;

# Borrow the execution's text streams. Empty lines are Strings; only EOF is Null.
native fn read_line() -> String?;
native fn read_stdin() -> String;
# Single-pass, lazy lines from the same stdin reader, without line terminators.
native fn stdin_lines() -> Range<String>;

# Raw text output. Use $std::text::format explicitly for brace formatting.
native fn print(text: String) -> Null;
native fn println(text: String) -> Null;
native fn eprint(text: String) -> Null;
native fn eprintln(text: String) -> Null;
native fn flush() -> Null;
native fn flush_error() -> Null;

fn prompt(text: String) -> String? {
    print(text);
    flush();
    read_line()
};

fn read(path) { read_text(path) };
fn lines(path) { read_lines(path) };
fn bytes(path) { read_bytes(path) };
fn write(path, text: String) { write_text(path, text) };
fn append(path, text: String) { append_text(path, text) };
fn copy(source, destination) { source -> destination };

# Metadata and link operations share the filesystem primitives and endpoint rules.
fn exists(path: Path or String) { $std::fs::exists(path) };
fn status(path: Path or String) { $std::fs::status(path) };
fn symlink_status(path: Path or String) { $std::fs::symlink_status(path) };
fn is_regular_file(path: Path or String) { $std::fs::is_regular_file(path) };
fn is_directory(path: Path or String) { $std::fs::is_directory(path) };
fn is_symlink(path: Path or String) { $std::fs::is_symlink(path) };
fn is_empty(path: Path or String) { $std::fs::is_empty(path) };
fn create_directory(path: Path or String) { $std::fs::create_directory(path) };
fn create_directories(path: Path or String) { $std::fs::create_directories(path) };
fn remove(path: Path or String) { $std::fs::remove(path) };
fn remove_all(path: Path or String) { $std::fs::remove_all(path) };
fn rename(source: Path or String, destination: Path or String) {
    $std::fs::rename(source, destination)
};
fn create_hard_link(target: Path or String, link: Path or String) {
    $std::fs::create_hard_link(target, link)
};
fn create_symlink(target: Path or String, link: Path or String) {
    $std::fs::create_symlink(target, link)
};
fn create_directory_symlink(target: Path or String, link: Path or String) {
    $std::fs::create_directory_symlink(target, link)
};
fn read_symlink(path: Path or String) { $std::fs::read_symlink(path) };
fn copy_symlink(source: Path or String, destination: Path or String) {
    $std::fs::copy_symlink(source, destination)
};
