# Absence is the language's Null. some boxes its payload so some(null) remains
# distinct from none; objects store data rather than a bag of method closures.
fn some(value?) -> $std::concepts::Option {
    scope {
        Item: decltype(value),
        value?: value
    }
};

fn none() {
    null
};

fn is_some(option?: $std::concepts::Option) -> Bool {
    option is not null
};

fn is_none(option?: $std::concepts::Option) -> Bool {
    option is null
};

fn map(option?: $std::concepts::Option, operation: Function)
    -> $std::concepts::Option? {
    if option is null {
        null
    } else {
        some(operation(option::value))
    }
};

fn and_then(option?: $std::concepts::Option, operation: Function)
    -> $std::concepts::Option? {
    if option is null {
        null
    } else {
        operation(option::value)
    }
};

fn fold(option?: $std::concepts::Option, on_some: Function, on_none: Function) {
    if option is null {
        on_none()
    } else {
        on_some(option::value)
    }
};

fn get_or(option?: $std::concepts::Option, fallback?) {
    if option is null {
        fallback
    } else {
        option::value
    }
};

fn get_or_else(option?: $std::concepts::Option, fallback: Function) {
    if option is null {
        fallback()
    } else {
        option::value
    }
};

fn or_else(option?: $std::concepts::Option, fallback: Function)
    -> $std::concepts::Option? {
    if option is null {
        fallback()
    } else {
        option
    }
};

fn filter(option?: $std::concepts::Option, predicate: Function)
    -> $std::concepts::Option? {
    if option is null {
        null
    } else {
        if predicate(option::value) {
            option
        } else {
            null
        }
    }
};

fn from_nullable(value?) -> $std::concepts::Option? {
    if value is null {
        null
    } else {
        some(value)
    }
};

fn to_nullable(option?: $std::concepts::Option) {
    if option is null {
        null
    } else {
        option::value
    }
};

fn flatten(option?: $std::concepts::Option) -> $std::concepts::Option? {
    if option is null {
        null
    } else {
        option::value
    }
};

fn zip(left?: $std::concepts::Option, right?: $std::concepts::Option)
    -> $std::concepts::Option? {
    if left is null {
        null
    } else {
        if right is null {
            null
        } else {
            some(
                scope {
                    first?: left::value,
                    second?: right::value
                }
            )
        }
    }
};

fn zip_with(
    left?: $std::concepts::Option,
    right?: $std::concepts::Option,
    operation: Function
) -> $std::concepts::Option? {
    if left is null {
        null
    } else {
        if right is null {
            null
        } else {
            some(operation(left::value, right::value))
        }
    }
};
