# Native signatures specialize item and callback result types at each call.
fn single(value?) { [value] };
fn identity(values: Range) { values };
fn all(values: Range) { values };
native fn of(value) -> Range;
native fn empty_of(element: Type) -> Range;
native fn less(left?, right?) -> Bool;
native fn size(values: Range) -> Number;
native fn take(values: Range, count: Number) -> Range;
native fn drop(values: Range, count: Number) -> Range;
native fn stride(values: Range, count: Number) -> Range;
native fn step(values: Range, count: Number) -> Range;
native fn reverse(values: Range) -> Range;
native fn unique(values: Range) -> Range;
native fn filter(values: Range, predicate: Function) -> Range;
native fn transform(values: Range, function: Function) -> Range;
native fn take_while(values: Range, predicate: Function) -> Range;
native fn drop_while(values: Range, predicate: Function) -> Range;
native fn empty(values: Range) -> Bool;
native fn contains(values: Range, value?) -> Bool;
native fn any(values: Range, predicate: Function) -> Bool;
native fn any_of(values: Range, predicate: Function) -> Bool;
native fn all_of(values: Range, predicate: Function) -> Bool;
native fn none(values: Range, predicate: Function) -> Bool;
native fn none_of(values: Range, predicate: Function) -> Bool;
native fn front(values: Range) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn back(values: Range) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn first(values: Range) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn last(values: Range) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn find(values: Range, value?) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn find_if(values: Range, predicate: Function) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;

# Iterator capabilities; adapters defer source and callback work until consumption.
native fn concat(left: Range, right: Range) -> Range;
native fn flatten(values: Range) -> Range;
native fn zip(left: Range, right: Range) -> Range<Scope>;
native fn enumerate_from(values: Range, start: Number) -> Range<Scope>;
native fn chunk(values: Range, count: Number) -> Range<Range>;
native fn slide(values: Range, count: Number) -> Range<Range>;
native fn materialize(values: Range) -> Range;
native fn sort(values: Range) -> Range;
native fn sort_with(values: Range, less: Function) -> Range;
native fn scan(values: Range, initial?, operation: Function) -> Range;
native fn sequence(start: Number, stop: Number, step: Number) -> Range<Number>;
native fn repeat(value?, count: Number) -> Range;
native fn at(values: Range, index: Number) -> Bool | String | Path | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn merge(left: Range, right: Range) -> Range;
native fn merge_with(left: Range, right: Range, compare: Function) -> Range;
native fn set_union(left: Range, right: Range) -> Range;
native fn set_union_with(left: Range, right: Range, compare: Function) -> Range;
native fn set_intersection(left: Range, right: Range) -> Range;
native fn set_intersection_with(left: Range, right: Range, compare: Function) -> Range;
native fn set_difference(left: Range, right: Range) -> Range;
native fn set_difference_with(left: Range, right: Range, compare: Function) -> Range;
native fn set_symmetric_difference(left: Range, right: Range) -> Range;
native fn set_symmetric_difference_with(left: Range, right: Range, compare: Function) -> Range;

# A cursor owns a membership snapshot. Its position is independent of Null items.
scope Cursor {
    begin: fn(values: Range) {
        let items = materialize(values);
        scope { items: items, position: 0, limit: size(items) }
    },
    clone: fn(self) {
        scope {
            items: self::items,
            position: self::position,
            limit: self::limit,
        }
    },
    has_value: fn(self) -> Bool { self::position < self::limit },
    value: fn(self) { at(self::items, self::position) },
    seek: fn(self, position: Number) -> Bool {
        if position < 0 or position > self::limit
            or position != $std::math::trunc(position) {
            return false;
        };
        self::position = position;
        true
    },
    advance: fn(self, offset: Number) -> Bool {
        if offset != $std::math::trunc(offset) { return false; };
        Cursor::seek(self, self::position + offset)
    },
    next: fn(self) -> Bool {
        if not Cursor::has_value(self) { return false; };
        self::position = self::position + 1;
        Cursor::has_value(self)
    },
    previous: fn(self) -> Bool {
        if self::position == 0 { return false; };
        self::position = self::position - 1;
        true
    },
    bound_with: fn(self, value?, compare: Function, upper: Bool) -> Number {
        let low = self::position;
        let high = self::limit;
        loop {
            if low >= high { break; };
            let middle = $std::math::floor(low + (high - low) / 2);
            let item? = at(self::items, middle);
            let before = if upper { not compare(value, item) }
                else { compare(item, value) };
            if before { low = middle + 1; } else { high = middle; };
        };
        low
    },
    lower_bound_with: fn(self, value?, compare: Function) -> Number {
        Cursor::bound_with(self, value, compare, false)
    },
    upper_bound_with: fn(self, value?, compare: Function) -> Number {
        Cursor::bound_with(self, value, compare, true)
    },
    lower_bound: fn(self, value?) -> Number {
        Cursor::lower_bound_with(self, value, less)
    },
    upper_bound: fn(self, value?) -> Number {
        Cursor::upper_bound_with(self, value, less)
    },
};

fn map(values: Range, operation: Function) { transform(values, operation) };
fn reject(values: Range, predicate: Function) {
    filter(values, fn(value?) { not predicate(value) })
};
fn flat_map(values: Range, operation: Function) {
    flatten(transform(values, operation))
};
fn join(values: Range) { flatten(values) };
fn enumerate(values: Range) { enumerate_from(values, 0) };
fn indices(values: Range) {
    transform(enumerate(values), fn(item) { item::index })
};
fn keys(pairs: Range) { transform(pairs, fn(pair) { pair::first }) };
fn values(pairs: Range) { transform(pairs, fn(pair) { pair::second }) };
fn iota(start: Number, stop: Number) { sequence(start, stop, 1) };
fn generate(count: Number, factory: Function) {
    transform(enumerate(repeat(null, count)), fn(item) { factory(item::index) })
};
fn slice(values: Range, start: Number, count: Number) {
    take(drop(values, start), count)
};
fn tail(values: Range) { drop(values, 1) };
fn init(values: Range) { transform(slide(values, 2), fn(pair) { first(pair) }) };
fn cache(values: Range) { materialize(values) };
fn sorted(values: Range) { sort(values) };
fn sorted_with(values: Range, less: Function) { sort_with(values, less) };
fn sort_by(values: Range, projection: Function) {
    let keyed = transform(values, fn(value?) {
        scope { key: projection(value), value?: value }
    });
    let ordered = sort_with(keyed, fn(left, right) { left::key < right::key });
    transform(ordered, fn(item) { item::value })
};

# Most terminals are ordinary typed programs; size has an indexed fast path.
fn distance(values: Range) { size(values) };
fn count_if(values: Range, predicate: Function) {
    size(filter(values, predicate))
};
fn matches(left?, right?) {
    if left is null {
        right is null
    } else {
        if right is null { false } else { contains([left], right) }
    }
};
fn count(values: Range, target?) {
    count_if(values, fn(value?) { matches(value, target) })
};
fn for_each(values: Range, operation: Function) {
    for value in values { operation(value); };
};
fn copy_if(values: Range, destination, predicate: Function) {
    filter(values, predicate) -> destination
};
fn fold(values: Range, initial?, operation: Function) {
    let state = scope { value?: initial };
    for value in values { state::value = operation(state::value, value); };
    state::value
};
fn reduce(values: Range, initial?, operation: Function) {
    fold(values, initial, operation)
};
fn fold_right(values: Range, initial?, operation: Function) {
    fold(reverse(values), initial, fn(accumulator?, value?) {
        operation(value, accumulator)
    })
};
fn sum(values: Range) {
    fold(values, 0, fn(accumulator: Number, value: Number) {
        accumulator + value
    })
};
fn product(values: Range) {
    fold(values, 1, fn(accumulator: Number, value: Number) {
        accumulator * value
    })
};
fn find_or(values: Range, fallback?, predicate: Function) {
    for value in values { if predicate(value) { return value; }; };
    fallback
};
fn first_or(values: Range, fallback?) {
    for value in values { return value; };
    fallback
};
fn last_or(values: Range, fallback?) {
    let state = scope { value?: fallback };
    for value in values { state::value = value; };
    state::value
};
fn at_or(values: Range, index: Number, fallback?) {
    first_or(drop(values, index), fallback)
};
fn index_if(values: Range, predicate: Function) {
    for item in enumerate(values) {
        if predicate(item::value) { return item::index; };
    };
    null
};
fn index_of(values: Range, target?) {
    index_if(values, fn(value?) { matches(value, target) })
};
fn min(values: Range) {
    let buffered = materialize(values);
    fold(drop(buffered, 1), first(buffered), fn(best, value) {
        if value < best { value } else { best }
    })
};
fn max(values: Range) {
    let buffered = materialize(values);
    fold(drop(buffered, 1), first(buffered), fn(best, value) {
        if value > best { value } else { best }
    })
};
fn min_by(values: Range, projection: Function) {
    let keyed = transform(values, fn(value?) {
        scope { key: projection(value), value?: value }
    });
    let buffered = materialize(keyed);
    let selected = fold(drop(buffered, 1), first(buffered), fn(best, value) {
        if value::key < best::key { value } else { best }
    });
    selected::value
};
fn max_by(values: Range, projection: Function) {
    let keyed = transform(values, fn(value?) {
        scope { key: projection(value), value?: value }
    });
    let buffered = materialize(keyed);
    let selected = fold(drop(buffered, 1), first(buffered), fn(best, value) {
        if value::key > best::key { value } else { best }
    });
    selected::value
};
fn partition(values: Range, predicate: Function) {
    let buffered = materialize(values);
    scope {
        accepted: filter(buffered, predicate),
        rejected: reject(buffered, predicate)
    }
};
fn equal(left: Range, right: Range) {
    let first = materialize(left);
    let second = materialize(right);
    if size(first) != size(second) { return false; };
    all_of(zip(first, second), fn(pair) { matches(pair::first, pair::second) })
};
fn starts_with(values: Range, prefix: Range) {
    let expected = materialize(prefix);
    let count = size(expected);
    let seen = 0;
    for pair in zip(take(values, count), expected) {
        if not matches(pair::first, pair::second) { return false; };
        seen = seen + 1;
    };
    seen == count
};
fn ends_with(values: Range, suffix: Range) {
    starts_with(reverse(values), reverse(suffix))
};
fn lexicographical_compare(left: Range, right: Range) {
    let first = materialize(left);
    let second = materialize(right);
    for pair in zip(first, second) {
        if pair::first < pair::second { return true; };
        if pair::second < pair::first { return false; };
    };
    size(first) < size(second)
};
fn adjacent_find_or(values: Range, fallback?, predicate: Function) {
    for pair in slide(values, 2) {
        if predicate(first(pair), last(pair)) { return first(pair); };
    };
    fallback
};

fn lower_bound_with(values: Range, value?, compare: Function) {
    Cursor::lower_bound_with(Cursor::begin(values), value, compare)
};
fn upper_bound_with(values: Range, value?, compare: Function) {
    Cursor::upper_bound_with(Cursor::begin(values), value, compare)
};
fn lower_bound(values: Range, value?) { lower_bound_with(values, value, less) };
fn upper_bound(values: Range, value?) { upper_bound_with(values, value, less) };
fn equal_range_with(values: Range, value?, compare: Function) {
    let cursor = Cursor::begin(values);
    scope {
        first: Cursor::lower_bound_with(cursor, value, compare),
        last: Cursor::upper_bound_with(cursor, value, compare),
    }
};
fn equal_range(values: Range, value?) { equal_range_with(values, value, less) };
fn binary_search_with(values: Range, value?, compare: Function) -> Bool {
    let cursor = Cursor::begin(values);
    let index = Cursor::lower_bound_with(cursor, value, compare);
    index < cursor::limit and not compare(value, at(cursor::items, index))
};
fn binary_search(values: Range, value?) { binary_search_with(values, value, less) };
fn is_sorted_with(values: Range, compare: Function) -> Bool {
    for pair in slide(values, 2) {
        if compare(last(pair), first(pair)) { return false; };
    };
    true
};
fn is_sorted(values: Range) { is_sorted_with(values, less) };
