# A vector owns its indexed storage. Only snapshot/take publish a Range.
native fn vector_new(initial: Range) -> Storage;
native fn vector_empty(element: Type) -> Storage;
native fn vector_empty_like(owner: Storage) -> Storage;
native fn vector_get(owner: Storage, index: Number) -> Bool | String | Path
    | Range | Function | Scope | Process | Connection | Type | Number | Null;
native fn vector_set(owner: Storage, index: Number, value?) -> Null;
native fn vector_push(owner: Storage, value?) -> Number;
native fn vector_pop(owner: Storage) -> Bool | String | Path | Range | Function
    | Scope | Process | Connection | Type | Number | Null;
native fn vector_insert(owner: Storage, index: Number, value?) -> Null;
native fn vector_remove(owner: Storage, index: Number) -> Bool | String | Path | Range
    | Function | Scope | Process | Connection | Type | Number | Null;
native fn vector_size(owner: Storage) -> Number;
native fn vector_clear(owner: Storage) -> Null;
native fn vector_snapshot(owner: Storage) -> Range;
native fn vector_take(owner: Storage) -> Range;
