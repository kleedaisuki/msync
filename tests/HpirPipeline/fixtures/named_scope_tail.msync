fn get_pool {
    scope Pool {
        id: 1
    }
}

let println = $std::io::println;
println(get_pool()::id as String);
let first = get_pool();
let second = get_pool();
first::id = 7;
println(second::id as String);
println(get_pool()::id as String);

fn declaration_only -> Null {
    scope Hidden {
        id: {
            $std::io::println("discarded init");
            0
        },
    };
};
println((declaration_only() is null) as String);

fn non_tail {
    scope Local { id: 2 }
    Local::id
};
println(non_tail() as String);

fn lazy_pool {
    scope Lazy {
        id: {
            $std::io::println("init");
            11
        },
    }
};
println("before");
println(lazy_pool()::id as String);
println(lazy_pool()::id as String);
