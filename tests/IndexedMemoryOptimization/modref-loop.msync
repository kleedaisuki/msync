let storage = $std::storage;
fn touch_other(values, digit: Number) {
    if digit == 0 {
        storage::vector_set(values, 1, 30);
    } else {
        storage::vector_set(values, 1, 40);
    };
    storage::vector_size(values)
};
let values = storage::vector_new([10, 20]);
let sum = 0;
let iteration = 0;
loop {
    if iteration >= 131072 {
        break;
    };
    let before = storage::vector_get(values, 0);
    let size = touch_other(values, iteration % 2);
    let after = storage::vector_get(values, 0);
    sum = sum + before + size + after;
    iteration = iteration + 1;
};
$std::io::println(sum as String);
