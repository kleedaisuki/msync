let storage = $std::storage;
let values = storage::vector_new([20, 10, 1, 40]);
let sum = 0;
let iteration = 0;
loop {
    if iteration >= 131072 {
        break;
    };
    let child = (iteration % 2) * 2;
    let left = storage::vector_get(values, child);
    let right = storage::vector_get(values, child + 1);
    if right < left {
        child = child + 1;
    };
    sum = sum + storage::vector_get(values, child);
    iteration = iteration + 1;
};
$std::io::println(sum as String);
