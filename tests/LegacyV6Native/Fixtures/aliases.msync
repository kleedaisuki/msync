fn counter(seed: Number) {
    let n = seed;
    fn next() { global n; n = n + 1; n };
    scope { next: next, value: fn() { n } }
};
let first = counter(0);
let second = counter(10);
let alias = first;
$std::io::println(first::next() as String);
$std::io::println(alias::next() as String);
$std::io::println(first::value() as String);
$std::io::println(second::next() as String);
let record = scope { n: 4, text: "hello", nested: scope { x: 7 } };
let same = record;
same::n = 9;
$std::io::println(record::n as String);
for n in [1, 2, 3] { $std::io::println((n + record::nested::x) as String); };
