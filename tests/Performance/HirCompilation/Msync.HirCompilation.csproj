<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>msync-hir-compilation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Msync.Core"><HintPath>$(FrozenAssemblies)/Msync.Core.dll</HintPath></Reference>
    <Reference Include="Msync.Compiler"><HintPath>$(FrozenAssemblies)/Msync.Compiler.dll</HintPath></Reference>
    <Reference Include="Msync.Optimization"><HintPath>$(FrozenAssemblies)/Msync.Optimization.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(FrozenAssemblies)/Msync.Hir.dll')">
    <Reference Include="Msync.Hir"><HintPath>$(FrozenAssemblies)/Msync.Hir.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HirPhaseProbe)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(HirPhaseProbe)' != 'true'">
    <Compile Remove="CandidateProgram.cs" />
    <Compile Remove="CompilerTailProbe.cs" />
  </ItemGroup>
  <Target Name="RequireFrozenAssemblies" BeforeTargets="ResolveReferences" Condition="'$(FrozenAssemblies)' == ''">
    <Error Text="Set FrozenAssemblies to an immutable product assembly directory." />
  </Target>
</Project>
