let Buffer = $std::storage::Buffer;
fn slot(table, capacity: Number, value: Number) -> Number {
    let mixed = (value * 2654435761) % 4294967296;
    let index = $std::math::floor(mixed / (4294967296 / capacity));
    loop {
        let old = Buffer::get(table, index);
        if old == -1 or old == value { return index; };
        index = (index + 1) % capacity;
    }
};
