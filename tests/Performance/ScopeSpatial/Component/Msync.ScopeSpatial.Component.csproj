<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>msync-scope-spatial-component</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Msync.Core"><HintPath>$(FrozenAssemblies)/Msync.Core.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenAssemblies" BeforeTargets="ResolveReferences" Condition="'$(FrozenAssemblies)' == ''">
    <Error Text="Set FrozenAssemblies to an immutable product assembly directory." />
  </Target>
</Project>
