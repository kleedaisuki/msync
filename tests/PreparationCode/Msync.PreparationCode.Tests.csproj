<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Msync.Runtime/Planning/PreparationCode.cs" Link="PreparationCode.cs" />
    <Compile Include="../../src/Msync.Runtime/Planning/PreparationRegions.cs" Link="PreparationRegions.cs" />
    <Reference Include="Msync.Core"><HintPath>$(FrozenAssemblies)/Msync.Core.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenAssemblies" BeforeTargets="ResolveReferences" Condition="'$(FrozenAssemblies)' == ''">
    <Error Text="Set FrozenAssemblies to an immutable product assembly directory." />
  </Target>
</Project>
