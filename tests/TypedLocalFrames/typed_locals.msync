fn integrate(limit: Number) {
    let steps = 0;
    let signed_zero = -0;
    let gain = 0;
    loop {
        if steps >= limit { break; };
        signed_zero = -signed_zero;
        gain = gain * 0.5 + 0.125;
        steps = steps + 1;
    };
    let shared = gain;
    fn advance() {
        global shared;
        shared = shared + 0.5;
    };
    advance();
    $std::io::println(steps as String);
    $std::io::println(signed_zero as String);
    $std::io::println(gain as String);
    $std::io::println(shared as String);
};

let line? = $std::io::read_line();
if line? {} else { integrate(line as Number); };
